digraph lamport {
    layout=neato;
    splines=false;
    overlap=true;
    outputorder=edgesfirst;
    pad="0.3,0.2";
    node [fontname="Helvetica", fontsize=9];
    edge [arrowsize=0.7];
    labelloc=t;
    fontname="Helvetica";
    fontsize=10;
    label="tagged (tests.rs): tolerates 0 crashes, breaks at 1: {crash(process after tagged[process→cluster@1]: 1)}\nfaults: crash(process after c18: →cluster@1 1)\n— delivered    ⋯ in flight    ╌ ✗ omitted (red) / lost to a crash (gray)";
    h0 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bbbbbb", fontsize=10, height=0.3, label="process", pos="0.0,0.0!"];
    end0 [shape=point, width=0.04, color="gray55", pos="0.0,-208.0!"];
    h1 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bbbbbb", fontsize=10, height=0.3, label="cluster@0", pos="113.7,0.0!"];
    end1 [shape=point, width=0.04, color="gray55", pos="113.7,-208.0!"];
    h2 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bbbbbb", fontsize=10, height=0.3, label="cluster@1", pos="227.4,0.0!"];
    end2 [shape=point, width=0.04, color="gray55", pos="227.4,-208.0!"];
    h3 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bbbbbb", fontsize=10, height=0.3, label="cluster@2", pos="341.1,0.0!"];
    end3 [shape=point, width=0.04, color="gray55", pos="341.1,-208.0!"];
    e0 [shape=point, width=0.08, color="black", pos="0.0,-16.0!"];
    e1 [shape=point, width=0.08, color="black", pos="0.0,-32.0!"];
    crash0 [shape=plaintext, style=filled, fillcolor=white, label="☠ crashed", fontsize=11, margin="0.04,0", height=0.16, pos="0.0,-48.0!"];
    e3 [shape=point, width=0.08, color="gray50", pos="0.0,-64.0!"];
    e4 [shape=point, width=0.08, color="black", pos="113.7,-96.0!"];
    o5 [shape=note, style=filled, fillcolor="#fff7d6", color="gray40", margin="0.05,0.02", height=0.2, label="⇒ (1, 0)", pos="156.9,-112.0!"];
    e5 [shape=point, width=0.06, color="gray40", pos="113.7,-112.0!"];
    o6 [shape=note, style=filled, fillcolor="#fff7d6", color="gray40", margin="0.05,0.02", height=0.2, label="⇒ 1", pos="143.6,-128.0!"];
    e6 [shape=point, width=0.06, color="gray40", pos="113.7,-128.0!"];
    e7 [shape=point, width=0.08, color="black", pos="227.4,-144.0!"];
    o8 [shape=note, style=filled, fillcolor="#fff7d6", color="gray40", margin="0.05,0.02", height=0.2, label="⇒ (1, 1)", pos="270.6,-160.0!"];
    e8 [shape=point, width=0.06, color="gray40", pos="227.4,-160.0!"];
    o9 [shape=note, style=filled, fillcolor="#fff7d6", color="gray40", margin="0.05,0.02", height=0.2, label="⇒ 1", pos="257.3,-176.0!"];
    e9 [shape=point, width=0.06, color="gray40", pos="227.4,-176.0!"];
    heal_l [shape=point, style=invis, width=0.01, pos="-27.0,-192.0!"];
    heal_r [shape=point, style=invis, width=0.01, pos="377.1,-192.0!"];
    t_heal [label="heal", shape=plaintext, fontcolor="#27ae60", pos="391.1,-192.0!"];
    heal_l -> heal_r [style=dashed, color="#27ae60", arrowhead=none];
    e0 -> e4 [tooltip="c18: 1"];
    l0 [shape=plaintext, style=filled, fillcolor=white, fontcolor="black", margin="0.03,0", height=0.14, label="c18: 1", pos="56.8,-56.0!"];
    e1 -> e7 [tooltip="c18: 1"];
    l1 [shape=plaintext, style=filled, fillcolor=white, fontcolor="black", margin="0.03,0", height=0.14, label="c18: 1", pos="56.8,-60.0!"];
    lost2 [shape=plaintext, label="✗", fontcolor="gray50", fontsize=13, width=0.2, height=0.2, fixedsize=true, margin=0, pos="341.1,-80.0!"];
    e3 -> lost2 [tooltip="c18: 1 (sender crashed)", style=dashed, color="gray50", arrowhead=none];
    l2 [shape=plaintext, style=filled, fillcolor=white, fontcolor="gray50", margin="0.03,0", height=0.14, label="c18: 1", pos="56.8,-66.7!"];
    h0 -> e0 [arrowhead=none, color="gray55"];
    e0 -> e1 [arrowhead=none, color="gray55"];
    e1 -> crash0 [arrowhead=none, color="gray55"];
    crash0 -> e3 [arrowhead=none, style=dotted, color="gray80"];
    e3 -> end0 [arrowhead=none, style=dotted, color="gray80"];
    h1 -> e4 [arrowhead=none, color="gray55"];
    e4 -> e5 [arrowhead=none, color="gray55"];
    e5 -> e6 [arrowhead=none, color="gray55"];
    e6 -> end1 [arrowhead=none, color="gray55"];
    h2 -> e7 [arrowhead=none, color="gray55"];
    e7 -> e8 [arrowhead=none, color="gray55"];
    e8 -> e9 [arrowhead=none, color="gray55"];
    e9 -> end2 [arrowhead=none, color="gray55"];
    h3 -> lost2 [arrowhead=none, color="gray55"];
    lost2 -> end3 [arrowhead=none, color="gray55"];
}
