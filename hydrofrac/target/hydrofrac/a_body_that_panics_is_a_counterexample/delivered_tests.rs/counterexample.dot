digraph lamport {
    layout=neato;
    splines=false;
    overlap=true;
    outputorder=edgesfirst;
    pad="0.3,0.2";
    node [fontname="Helvetica", fontsize=9];
    edge [arrowsize=0.7];
    labelloc=t;
    fontname="Helvetica";
    fontsize=10;
    label="delivered (tests.rs): breaks without faults (the run panicked: unlucky)\n— delivered    ⋯ in flight    ╌ ✗ omitted (red) / lost to a crash (gray)";
}
