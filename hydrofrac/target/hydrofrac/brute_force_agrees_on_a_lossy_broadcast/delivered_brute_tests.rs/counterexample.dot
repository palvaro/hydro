digraph lamport {
    layout=neato;
    splines=false;
    overlap=true;
    outputorder=edgesfirst;
    pad="0.3,0.2";
    node [fontname="Helvetica", fontsize=9];
    edge [arrowsize=0.7];
    labelloc=t;
    fontname="Helvetica";
    fontsize=10;
    label="delivered (brute_tests.rs): breaks under omissions alone: {omit(delivered[process→cluster@0]: 1)}\nfaults: omit(c18: process→cluster@0 1)\n— delivered    ⋯ in flight    ╌ ✗ omitted (red) / lost to a crash (gray)";
    h0 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bbbbbb", fontsize=10, height=0.3, label="process", pos="0.0,0.0!"];
    end0 [shape=point, width=0.04, color="gray55", pos="0.0,-192.0!"];
    h1 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bbbbbb", fontsize=10, height=0.3, label="cluster@0", pos="113.7,0.0!"];
    end1 [shape=point, width=0.04, color="gray55", pos="113.7,-192.0!"];
    h2 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bbbbbb", fontsize=10, height=0.3, label="cluster@1", pos="227.4,0.0!"];
    end2 [shape=point, width=0.04, color="gray55", pos="227.4,-192.0!"];
    h3 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bbbbbb", fontsize=10, height=0.3, label="cluster@2", pos="341.1,0.0!"];
    end3 [shape=point, width=0.04, color="gray55", pos="341.1,-192.0!"];
    e0 [shape=point, width=0.08, color="black", pos="0.0,-16.0!"];
    e1 [shape=point, width=0.08, color="black", pos="0.0,-48.0!"];
    e2 [shape=point, width=0.08, color="black", pos="0.0,-64.0!"];
    e3 [shape=point, width=0.08, color="black", pos="227.4,-80.0!"];
    o4 [shape=note, style=filled, fillcolor="#fff7d6", color="gray40", margin="0.05,0.02", height=0.2, label="⇒ 01000000", pos="275.9,-96.0!"];
    e4 [shape=point, width=0.06, color="gray40", pos="227.4,-96.0!"];
    o5 [shape=note, style=filled, fillcolor="#fff7d6", color="gray40", margin="0.05,0.02", height=0.2, label="⇒ 1", pos="257.3,-112.0!"];
    e5 [shape=point, width=0.06, color="gray40", pos="227.4,-112.0!"];
    e6 [shape=point, width=0.08, color="black", pos="341.1,-128.0!"];
    o7 [shape=note, style=filled, fillcolor="#fff7d6", color="gray40", margin="0.05,0.02", height=0.2, label="⇒ 01000000", pos="389.6,-144.0!"];
    e7 [shape=point, width=0.06, color="gray40", pos="341.1,-144.0!"];
    o8 [shape=note, style=filled, fillcolor="#fff7d6", color="gray40", margin="0.05,0.02", height=0.2, label="⇒ 1", pos="371.0,-160.0!"];
    e8 [shape=point, width=0.06, color="gray40", pos="341.1,-160.0!"];
    heal_l [shape=point, style=invis, width=0.01, pos="-27.0,-176.0!"];
    heal_r [shape=point, style=invis, width=0.01, pos="377.1,-176.0!"];
    t_heal [label="heal", shape=plaintext, fontcolor="#27ae60", pos="391.1,-176.0!"];
    heal_l -> heal_r [style=dashed, color="#27ae60", arrowhead=none];
    lost0 [shape=plaintext, label="✗", fontcolor="#c0392b", fontsize=13, width=0.2, height=0.2, fixedsize=true, margin=0, pos="113.7,-32.0!"];
    e0 -> lost0 [tooltip="c18: 1 (omitted)", style=dashed, color="#c0392b", arrowhead=none];
    l0 [shape=plaintext, style=filled, fillcolor=white, fontcolor="#c0392b", margin="0.03,0", height=0.14, label="c18: 1", pos="56.8,-24.0!"];
    e1 -> e3 [tooltip="c18: 1"];
    l1 [shape=plaintext, style=filled, fillcolor=white, fontcolor="black", margin="0.03,0", height=0.14, label="c18: 1", pos="56.8,-56.0!"];
    e2 -> e6 [tooltip="c18: 1"];
    l2 [shape=plaintext, style=filled, fillcolor=white, fontcolor="black", margin="0.03,0", height=0.14, label="c18: 1", pos="56.8,-74.7!"];
    h0 -> e0 [arrowhead=none, color="gray55"];
    e0 -> e1 [arrowhead=none, color="gray55"];
    e1 -> e2 [arrowhead=none, color="gray55"];
    e2 -> end0 [arrowhead=none, color="gray55"];
    h1 -> lost0 [arrowhead=none, color="gray55"];
    lost0 -> end1 [arrowhead=none, color="gray55"];
    h2 -> e3 [arrowhead=none, color="gray55"];
    e3 -> e4 [arrowhead=none, color="gray55"];
