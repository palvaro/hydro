#!/usr/bin/env bash
# Sedge: deploys every `#[sedge::overload_check(...)]` in a crate on localhost and runs overload
# trials against it.
#
#   ./scripts/sedge [options] <crate> [function-substring]
#
# Options (all optional; see `sedge::harness::USAGE`, or run the runner with a bad option):
#   --config NAME  --include-ignored  --factors F1,F2,...  --trials N  --trigger-multiple M
#   --before S  --trigger S  --tail S  --grace S  --seed N  --features A,B
#   capacity: --backend docker|none  --cpus C | ROLE=C  --cpu-period-us P  --node-cpus LIST
#             --harness-cpus LIST  --image IMAGE  --memory-mb M
#   build:    --deploy-profile NAME (default `profile`, an optimized build; `dev` for debug)
#   μ:        --mu RPS  --recalibrate  --no-calibrate  --calibrate-only  --probe-step S
#             --probe-start RPS
#   triggers: --cpu-dip K  --cpu-dip-nodes SEL,...  --dip TIMER=K (a timing fault)
#
# Each deployed node runs in its own Docker container with a fixed CPU quota (set at container
# start; only the opt-in --cpu-dip changes it mid-run), and μ is measured under that quota before
# the sweep unless --mu gives it.
#
# The crate under check lists `sedge` as an optional dependency, declares a `sedge` feature that
# enables it, and writes its attributes as `#[cfg_attr(feature = "sedge", sedge::overload_check(...))]`;
# this command enables that feature when it builds the crate, so ordinary builds never link the
# harness.
#
# Each trial prints its verdict as it finishes; the end of the run prints every verdict and a
# summary per factor. Per-second traces and a results table are written to target/sedge/.
#
# Requires python3 (to read `cargo metadata` and write the runner's manifest).
set -euo pipefail

# Options are passed through to the runner; the first non-option argument is the crate.
passthrough=()
crate=
substring=
while [[ $# -gt 0 ]]; do
  case $1 in
    -h|--help)
      echo "usage: $0 [options] <crate> [function-substring]"
      echo "options are passed to the runner; see sedge::harness::USAGE"
      exit 0
      ;;
    --include-ignored|--recalibrate|--no-calibrate|--calibrate-only) passthrough+=("$1"); shift ;;
    --*)
      if [[ $# -lt 2 ]]; then echo "$1 requires a value" >&2; exit 2; fi
      passthrough+=("$1" "$2"); shift 2
      ;;
    *)
      if [[ -z $crate ]]; then crate=$1
      elif [[ -z $substring ]]; then substring=$1
      else echo "unexpected argument: $1" >&2; exit 2
      fi
      shift
      ;;
  esac
done
if [[ -z $crate ]]; then
  echo "usage: $0 [options] <crate> [function-substring]" >&2
  exit 2
fi

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

# Resolve the package through Cargo rather than guessing its directory or Rust library name, and
# check that it declares the `sedge` feature.
metadata=$(cargo metadata --format-version=1 --no-deps --manifest-path "$root/Cargo.toml")
package_manifest=$(python3 -c '
import json, sys
name = sys.argv[1]
packages = [p for p in json.load(sys.stdin)["packages"] if p["name"] == name]
if len(packages) != 1:
    print(f"expected one workspace package named {name!r}, found {len(packages)}", file=sys.stderr)
    raise SystemExit(2)
if "sedge" not in packages[0]["features"]:
    print(f"package {name!r} has no `sedge` feature; add `sedge = {{ path = \"../sedge\", optional = true }}` "
          "to its [dependencies] and `sedge = [\"dep:sedge\"]` to its [features]", file=sys.stderr)
    raise SystemExit(2)
print(packages[0]["manifest_path"])
' "$crate" <<<"$metadata")
package_dir=$(dirname "$package_manifest")
stageleft_version=$(python3 - "$root/Cargo.toml" <<'PY'
import re, sys
text = open(sys.argv[1]).read()
m = re.search(r'^stageleft\s*=\s*(?:"([^"]+)"|\{[^}]*version\s*=\s*"([^"]+)")', text, re.M)
if not m:
    print("could not find the workspace `stageleft` dependency in Cargo.toml", file=sys.stderr)
    raise SystemExit(2)
print(m.group(1) or m.group(2))
PY
)

# Cargo's target directory: $CARGO_TARGET_DIR if set (so it can live outside the repository),
# otherwise target/ at the root. Results go under it, Cress's and Sedge's side by side.
target_dir=${CARGO_TARGET_DIR:-$root/target}
export SEDGE_RESULTS_DIR="${SEDGE_RESULTS_DIR:-$target_dir/sedge}"
runner_dir="$SEDGE_RESULTS_DIR/runner"
mkdir -p "$SEDGE_RESULTS_DIR/traces" "$runner_dir/src"

# This tiny generated binary links the requested crate so its registered checks are present. It is
# built optimized: it is the load generator, and an unoptimized generator (serializing every
# request byte by byte) tops out at a few thousand requests per second, below the capacity of the
# programs it is meant to overload.
# Keeping it under target/ avoids adding harness plumbing to the user's crate.
python3 - "$runner_dir/Cargo.toml" "$package_dir" "$root/sedge" "$crate" "$stageleft_version" <<'PY'
import json, pathlib, sys
out, checked, sedge = map(pathlib.Path, sys.argv[1:4])
crate, stageleft_version = sys.argv[4], sys.argv[5]
out.write_text(f'''[package]
name = "sedge-runner"
version = "0.0.0"
edition = "2024"
publish = false

[workspace]

[workspace.lints.rust]
unexpected_cfgs = {{ level = "warn", check-cfg = ["cfg(stageleft_runtime)", "cfg(stageleft_trybuild)"] }}

[dependencies]
checked_crate = {{ path = {json.dumps(str(checked))}, package = {json.dumps(crate)}, features = ["sedge"] }}
sedge = {{ path = {json.dumps(str(sedge))} }}
stageleft = {json.dumps(stageleft_version)}
''')
PY
rm -f "$runner_dir/Cargo.lock"
cp "$root/Cargo.lock" "$runner_dir/Cargo.lock"

cat > "$runner_dir/src/main.rs" <<'RS'
use checked_crate as _;

fn main() {
    // The deployed program is generated from the checked crate, not from this runner.
    // SAFETY: this process is single-threaded here, before any trial starts.
    unsafe {
        std::env::set_var(
            "CARGO_MANIFEST_DIR",
            std::env::var_os("SEDGE_SOURCE_DIR").expect("missing checked crate path"),
        );
    }
    let run = match sedge::harness::RunConfig::from_args(std::env::args().skip(1)) {
        Ok(run) => run,
        Err(message) => {
            eprintln!("sedge: {message}");
            std::process::exit(2);
        }
    };
    match sedge::harness::run_registered_checks(&run) {
        Ok(results) => sedge::harness::print_results(&results),
        Err(message) => {
            eprintln!("sedge: {message}");
            std::process::exit(2);
        }
    }
}
RS

SEDGE_SOURCE_DIR="$package_dir" \
CARGO_TARGET_DIR="$target_dir" \
cargo run --quiet --release --manifest-path "$runner_dir/Cargo.toml" -- "${passthrough[@]}" ${substring:+"$substring"}
