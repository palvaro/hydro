+// TEMPORARY profiling (cost-table measurement; not to be committed).
+thread_local! { static PROF: std::cell::Cell<[u128; 4]> = const { std::cell::Cell::new([0; 4]) }; }
+fn prof_add(i: usize, t: Instant) {
+    PROF.with(|p| { let mut a = p.get(); a[i] += t.elapsed().as_micros(); if i == 2 { a[3] += 1; } p.set(a); });
+}
+struct ProfGuard(Instant);
+impl Drop for ProfGuard { fn drop(&mut self) { prof_add(2, self.0); } }
+fn prof_dump(label: &str, stats: &Stats) {
+    use std::io::Write;
+    let Ok(path) = std::env::var("HF_PROF") else { return };
+    let a = PROF.with(|p| p.get());
+    let b = crate::races::ilp::ILPPROF.with(|p| p.get());
+    let test = std::thread::current().name().unwrap_or("?").to_owned();
+    let line = format!("{test}\t{label}\tsets={}\tsched={}\twall_us={}\tnext_us={}\texplore_us={}\tcallback_us={}\tcallbacks={}\tpropose_calls={}\tbuild_us={}\tsolve_us={}\tconstraints_total={}\tmax_universe={}\tmax_tried={}\n",
+        stats.hypotheses, stats.schedules, stats.wall.as_micros(), a[0], a[1], a[2], a[3], b[0], b[1], b[2], b[3], b[4], b[5]);
+    std::fs::OpenOptions::new().create(true).append(true).open(path).unwrap().write_all(line.as_bytes()).unwrap();
+}
