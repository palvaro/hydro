// The dataflow of `reliable_broadcast_closed` (hydro_std/src/ec_inference_demos/reliable_broadcast.rs
// at 2f156b6335) as `Spec::all_labels` sees it: operators clustered by location, the region whose
// collections carry the `EventualConsistency` label shaded, the two introducing nodes (bold) and the
// exit (double border) marked.
//
// Render: dot -Tpng -Gdpi=150 reliable_broadcast_regions.dot -o reliable_broadcast_regions.png
digraph reliable_broadcast_regions {
    rankdir=TB;
    fontname="DejaVu Sans";
    fontsize=10;
    node [fontname="DejaVu Sans", fontsize=10, shape=box, style="rounded,filled", fillcolor=white, penwidth=1];
    edge [fontname="DejaVu Sans", fontsize=8, arrowsize=0.7];
    compound=true;
    newrank=true;
    ranksep=0.35;
    nodesep=0.3;

    subgraph cluster_source {
        label="Source (Process)";
        labeljust=l;
        style="rounded";
        color=gray50;
        sim_input [label=<sim_input<BR/><FONT POINT-SIZE="8">two items, TotalOrder</FONT>>];
    }

    subgraph cluster_members {
        label="Members (Cluster)";
        labeljust=l;
        style="rounded";
        color=gray50;

        subgraph cluster_ec {
            label=<<FONT POINT-SIZE="9">collections labelled <I>EventualConsistency</I></FONT>>;
            labeljust=r;
            style="rounded,filled";
            fillcolor="#e6f0fa";
            color="#8aa8c8";

            initial [label=<<B>broadcast_closed</B><BR/><FONT POINT-SIZE="8">Source → Members, TCP.fail_stop()<BR/>▶ label enters (:130)</FONT>>, penwidth=2.5, fillcolor="#cfe0f5"];
            fwd [label=<forward_ref<BR/><FONT POINT-SIZE="8">rebroadcast_fwd, declared on initial.location()</FONT>>, fillcolor="#cfe0f5"];
            merge [label="merge_unordered", fillcolor="#cfe0f5"];
            unique [label=<unique<BR/><FONT POINT-SIZE="8">new_messages: the delivered set (:149)</FONT>>, fillcolor="#cfe0f5"];
            echo [label=<<B>broadcast_closed</B><BR/><FONT POINT-SIZE="8">Members → Members (echo), TCP.fail_stop()<BR/>▶ label enters (:156)</FONT>>, penwidth=2.5, fillcolor="#cfe0f5"];
        }

        weaken [label=<weaken_consistency<BR/><FONT POINT-SIZE="8">◀ label exits</FONT>>, shape=box, peripheries=2, style="rounded,filled", fillcolor=white];
        output [label="sim_cluster_output"];
    }

    sim_input -> initial [style=dashed, label=" network hop"];
    initial -> merge;
    fwd -> merge;
    merge -> unique;
    unique -> echo [label=" clone"];
    echo -> fwd [style=dashed, label=" network hop; .values()\n completes the forward_ref", constraint=false];
    unique -> weaken;
    weaken -> output;

    { rank=same; initial; fwd; }
}
