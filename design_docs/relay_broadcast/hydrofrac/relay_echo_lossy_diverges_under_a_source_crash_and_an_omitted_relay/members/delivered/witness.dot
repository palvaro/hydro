    e26 -> e29 [tooltip="★ relay: Relay { from: 0, id: 1 }", arrowsize=0.7, penwidth=2, color="#d35400"];
    e27 -> e33 [tooltip="★ relay: Relay { from: 0, id: 1 }", arrowsize=0.7, penwidth=2, color="#d35400"];
    e54 -> e56 [tooltip="ack: Ack { from: 2, id: 1 }", arrowsize=0.7];
    e59 -> e61 [tooltip="ack: Ack { from: 1, id: 1 }", arrowsize=0.7];
    // message labels
    l0 [shape=plaintext, style=filled, fillcolor=white, fontsize=9, fontcolor="#d35400", margin="0.03,0", height=0.14, label="★ bcast: 1", pos="120.5,-112.0!"];
    l1 [shape=plaintext, style=filled, fillcolor=white, fontsize=9, fontcolor="gray50", margin="0.03,0", height=0.14, label="bcast: 1", pos="120.5,-52.0!"];
    l2 [shape=plaintext, style=filled, fillcolor=white, fontsize=9, fontcolor="gray50", margin="0.03,0", height=0.14, label="bcast: 1", pos="120.5,-82.7!"];
    l3 [shape=plaintext, style=filled, fillcolor=white, fontsize=9, fontcolor="gray50", margin="0.03,0", height=0.14, label="bcast: 2", pos="168.6,-123.2!"];
    l4 [shape=plaintext, style=filled, fillcolor=white, fontsize=9, fontcolor="gray50", margin="0.03,0", height=0.14, label="bcast: 2", pos="120.5,-148.0!"];
    l5 [shape=plaintext, style=filled, fillcolor=white, fontsize=9, fontcolor="gray50", margin="0.03,0", height=0.14, label="bcast: 2", pos="120.5,-178.7!"];
    l8 [shape=plaintext, style=filled, fillcolor=white, fontsize=9, fontcolor="#d35400", margin="0.03,0", height=0.14, label="★ relay: Relay { from: 0, id: 1 }", pos="361.4,-244.0!"];
    l9 [shape=plaintext, style=filled, fillcolor=white, fontsize=9, fontcolor="#d35400", margin="0.03,0", height=0.14, label="★ relay: Relay { from: 0, id: 1 }", pos="361.4,-280.0!"];
    l12 [shape=plaintext, style=filled, fillcolor=white, fontsize=9, fontcolor="black", margin="0.03,0", height=0.14, label="ack: Ack { from: 2, id: 1 }", pos="602.2,-356.0!"];
    l13 [shape=plaintext, style=filled, fillcolor=white, fontsize=9, fontcolor="black", margin="0.03,0", height=0.14, label="ack: Ack { from: 1, id: 1 }", pos="361.4,-392.0!"];
