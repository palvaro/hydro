    e34 [shape=point, width=0.06, color="gray40", pos="722.7,-320.0!"];
    e54 [shape=point, width=0.08, color="black", pos="722.7,-352.0!"];
    e56 [shape=point, width=0.08, color="black", pos="240.9,-368.0!"];
    e59 [shape=point, width=0.08, color="black", pos="481.8,-384.0!"];
    e61 [shape=point, width=0.08, color="black", pos="240.9,-400.0!"];
