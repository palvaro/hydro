    // outputs
    o11 [shape=note, fontsize=9, style=filled, fillcolor="#fff7d6", color="gray40", margin="0.05,0.02", height=0.2, label="⇒ 0100000000000000", pos="300.6,-224.0!"];
    o30 [shape=note, fontsize=9, style=filled, fillcolor="#fff7d6", color="gray40", margin="0.05,0.02", height=0.2, label="⇒ 0100000000000000", pos="541.5,-288.0!"];
    o34 [shape=note, fontsize=9, style=filled, fillcolor="#fff7d6", color="gray40", margin="0.05,0.02", height=0.2, label="⇒ 0100000000000000", pos="782.4,-320.0!"];
