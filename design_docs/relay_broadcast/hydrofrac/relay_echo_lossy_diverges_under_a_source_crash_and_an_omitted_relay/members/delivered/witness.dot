    end2 [shape=point, width=0.04, color="gray55", pos="481.8,-416.0!"];
    end3 [shape=point, width=0.04, color="gray55", pos="722.7,-416.0!"];
    h0 -> e1 [arrowhead=none, color="gray55"];
