    h2 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bbbbbb", height=0.3, label="member@1", pos="481.8,0.0!"];
    h3 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bbbbbb", height=0.3, label="member@2", pos="722.7,0.0!"];
    e1 [shape=point, width=0.08, color="#d35400", pos="0.0,-16.0!"];
