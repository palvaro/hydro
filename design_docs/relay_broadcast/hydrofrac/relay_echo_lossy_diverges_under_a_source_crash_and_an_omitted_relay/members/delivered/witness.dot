    e2 [shape=point, width=0.08, color="gray50", pos="0.0,-48.0!"];
    lost1 [shape=plaintext, label="✗", fontcolor="gray50", fontsize=13, width=0.2, height=0.2, fixedsize=true, margin=0, pos="481.8,-64.0!"];
    e3 [shape=point, width=0.08, color="gray50", pos="0.0,-80.0!"];
    lost2 [shape=plaintext, label="✗", fontcolor="gray50", fontsize=13, width=0.2, height=0.2, fixedsize=true, margin=0, pos="722.7,-96.0!"];
    e4 [shape=point, width=0.08, color="gray50", pos="0.0,-112.0!"];
    lost3 [shape=plaintext, label="✗", fontcolor="gray50", fontsize=13, width=0.2, height=0.2, fixedsize=true, margin=0, pos="240.9,-128.0!"];
