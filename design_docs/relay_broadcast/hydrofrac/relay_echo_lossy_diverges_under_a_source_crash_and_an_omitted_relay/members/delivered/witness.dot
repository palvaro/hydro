digraph lamport {
    layout=neato;
    splines=false;
    overlap=true;
    outputorder=edgesfirst;
    pad="0.3,0.2";
    node [fontname="Helvetica", fontsize=10];
    edge [fontname="Helvetica", fontsize=9];
    labelloc=t;
    fontname="Helvetica";
    label=<<FONT POINT-SIZE="12">goal held under {crash(source after bcast[→0]:1)}: its support (★)</FONT><BR/><FONT POINT-SIZE="8" COLOR="gray40">— delivered    ⋯ in flight    ╌ ✗ omitted (red) / lost to a crash (gray)    ★ support</FONT>>;
    // the end of finite failures
    eff_l [shape=point, style=invis, width=0.01, pos="-27.0,-336.0!"];
    eff_r [shape=point, style=invis, width=0.01, pos="758.7,-336.0!"];
    t_eff [label="EFF", shape=plaintext, fontcolor="gray45", fontsize=9, margin="0.04,0", height=0.12, pos="770.7,-336.0!"];
    eff_l -> eff_r [style=dashed, color="gray45", arrowhead=none];
    // lanes
    h0 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bbbbbb", height=0.3, label="source", pos="0.0,0.0!"];
