    lost5 [shape=plaintext, label="✗", fontcolor="gray50", fontsize=13, width=0.2, height=0.2, fixedsize=true, margin=0, pos="722.7,-192.0!"];
    e9 [shape=point, width=0.08, color="#d35400", pos="240.9,-208.0!"];
    e11 [shape=point, width=0.06, color="gray40", pos="240.9,-224.0!"];
