digraph lamport {
    layout=neato;
    splines=false;
    overlap=true;
    outputorder=edgesfirst;
    pad="0.3,0.2";
    node [fontname="Helvetica", fontsize=10];
    edge [fontname="Helvetica", fontsize=9];
    labelloc=t;
    fontname="Helvetica";
    label=<<FONT POINT-SIZE="12">goal violated by {crash(source after bcast[→1]:2)}</FONT><BR/><FONT POINT-SIZE="8" COLOR="gray40">— delivered    ⋯ in flight    ╌ ✗ omitted (red) / lost to a crash (gray)    ★ support</FONT>>;
    // the end of finite failures
    eff_l [shape=point, style=invis, width=0.01, pos="-27.0,-304.0!"];
    eff_r [shape=point, style=invis, width=0.01, pos="361.2,-304.0!"];
    t_eff [label="EFF", shape=plaintext, fontcolor="gray45", fontsize=9, margin="0.04,0", height=0.12, pos="373.2,-304.0!"];
    eff_l -> eff_r [style=dashed, color="gray45", arrowhead=none];
    // lanes
    h0 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bbbbbb", height=0.3, label="source", pos="0.0,0.0!"];
    h1 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bbbbbb", height=0.3, label="member@0", pos="108.4,0.0!"];
    h2 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bbbbbb", height=0.3, label="member@1", pos="216.8,0.0!"];
    h3 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bbbbbb", height=0.3, label="member@2", pos="325.2,0.0!"];
    e1 [shape=point, width=0.08, color="black", pos="0.0,-16.0!"];
    e2 [shape=point, width=0.08, color="black", pos="0.0,-32.0!"];
    e3 [shape=point, width=0.08, color="black", pos="0.0,-48.0!"];
    e4 [shape=point, width=0.08, color="black", pos="0.0,-64.0!"];
    e5 [shape=point, width=0.08, color="black", pos="0.0,-80.0!"];
    crash0 [shape=plaintext, style=filled, fillcolor=white, label="☠ crashed", fontsize=11, margin="0.04,0", height=0.16, pos="0.0,-96.0!"];
    e6 [shape=point, width=0.08, color="gray50", pos="0.0,-112.0!"];
    lost5 [shape=plaintext, label="✗", fontcolor="gray50", fontsize=13, width=0.2, height=0.2, fixedsize=true, margin=0, pos="325.2,-128.0!"];
    e9 [shape=point, width=0.08, color="black", pos="108.4,-144.0!"];
    e11 [shape=point, width=0.08, color="black", pos="108.4,-160.0!"];
    e13 [shape=point, width=0.06, color="gray40", pos="108.4,-176.0!"];
    e15 [shape=point, width=0.06, color="gray40", pos="108.4,-192.0!"];
    e18 [shape=point, width=0.08, color="black", pos="216.8,-208.0!"];
    e20 [shape=point, width=0.08, color="black", pos="216.8,-224.0!"];
    e22 [shape=point, width=0.06, color="gray40", pos="216.8,-240.0!"];
    e24 [shape=point, width=0.06, color="gray40", pos="216.8,-256.0!"];
    e27 [shape=point, width=0.08, color="black", pos="325.2,-272.0!"];
    e29 [shape=point, width=0.06, color="gray40", pos="325.2,-288.0!"];
    end0 [shape=point, width=0.04, color="gray55", pos="0.0,-320.0!"];
    end1 [shape=point, width=0.04, color="gray55", pos="108.4,-320.0!"];
    end2 [shape=point, width=0.04, color="gray55", pos="216.8,-320.0!"];
    end3 [shape=point, width=0.04, color="gray55", pos="325.2,-320.0!"];
    h0 -> e1 [arrowhead=none, color="gray55"];
    e1 -> e2 [arrowhead=none, color="gray55"];
    e2 -> e3 [arrowhead=none, color="gray55"];
    e3 -> e4 [arrowhead=none, color="gray55"];
    e4 -> e5 [arrowhead=none, color="gray55"];
    e5 -> crash0 [arrowhead=none, color="gray55"];
    crash0 -> e6 [arrowhead=none, style=dotted, color="gray80"];
    e6 -> end0 [arrowhead=none, style=dotted, color="gray80"];
    h1 -> e9 [arrowhead=none, color="gray55"];
    e9 -> e11 [arrowhead=none, color="gray55"];
    e11 -> e13 [arrowhead=none, color="gray55"];
    e13 -> e15 [arrowhead=none, color="gray55"];
    e15 -> end1 [arrowhead=none, color="gray55"];
    h2 -> e18 [arrowhead=none, color="gray55"];
    e18 -> e20 [arrowhead=none, color="gray55"];
    e20 -> e22 [arrowhead=none, color="gray55"];
    e22 -> e24 [arrowhead=none, color="gray55"];
    e24 -> end2 [arrowhead=none, color="gray55"];
    h3 -> lost5 [arrowhead=none, color="gray55"];
    lost5 -> e27 [arrowhead=none, color="gray55"];
    e27 -> e29 [arrowhead=none, color="gray55"];
    e29 -> end3 [arrowhead=none, color="gray55"];
    // outputs
    o13 [shape=note, fontsize=9, style=filled, fillcolor="#fff7d6", color="gray40", margin="0.05,0.02", height=0.2, label="⇒ 0100000000000000", pos="168.1,-176.0!"];
    o15 [shape=note, fontsize=9, style=filled, fillcolor="#fff7d6", color="gray40", margin="0.05,0.02", height=0.2, label="⇒ 0200000000000000", pos="168.1,-192.0!"];
    o22 [shape=note, fontsize=9, style=filled, fillcolor="#fff7d6", color="gray40", margin="0.05,0.02", height=0.2, label="⇒ 0100000000000000", pos="276.5,-240.0!"];
    o24 [shape=note, fontsize=9, style=filled, fillcolor="#fff7d6", color="gray40", margin="0.05,0.02", height=0.2, label="⇒ 0200000000000000", pos="276.5,-256.0!"];
    o29 [shape=note, fontsize=9, style=filled, fillcolor="#fff7d6", color="gray40", margin="0.05,0.02", height=0.2, label="⇒ 0100000000000000", pos="384.9,-288.0!"];
    // messages
    e1 -> e9 [tooltip="bcast: 1", arrowsize=0.7];
    e2 -> e18 [tooltip="bcast: 1", arrowsize=0.7];
    e3 -> e27 [tooltip="bcast: 1", arrowsize=0.7];
    e4 -> e11 [tooltip="bcast: 2", arrowsize=0.7];
    e5 -> e20 [tooltip="bcast: 2", arrowsize=0.7];
    e6 -> lost5 [tooltip="bcast: 2 (sender crashed)", style=dashed, color="gray50", arrowhead=none];
    // message labels
    l0 [shape=plaintext, style=filled, fillcolor=white, fontsize=9, fontcolor="black", margin="0.03,0", height=0.14, label="bcast: 1", pos="54.2,-80.0!"];
    l1 [shape=plaintext, style=filled, fillcolor=white, fontsize=9, fontcolor="black", margin="0.03,0", height=0.14, label="bcast: 1", pos="54.2,-76.0!"];
    l2 [shape=plaintext, style=filled, fillcolor=white, fontsize=9, fontcolor="black", margin="0.03,0", height=0.14, label="bcast: 1", pos="260.2,-227.2!"];
    l3 [shape=plaintext, style=filled, fillcolor=white, fontsize=9, fontcolor="black", margin="0.03,0", height=0.14, label="bcast: 2", pos="54.2,-112.0!"];
    l4 [shape=plaintext, style=filled, fillcolor=white, fontsize=9, fontcolor="black", margin="0.03,0", height=0.14, label="bcast: 2", pos="173.4,-207.2!"];
    l5 [shape=plaintext, style=filled, fillcolor=white, fontsize=9, fontcolor="gray50", margin="0.03,0", height=0.14, label="bcast: 2", pos="162.6,-120.0!"];
}
