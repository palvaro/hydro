digraph lamport {
    layout=neato;
    splines=false;
    overlap=true;
    outputorder=edgesfirst;
    pad="0.3,0.2";
    node [fontname="Helvetica", fontsize=9];
    edge [arrowsize=0.7];
    labelloc=t;
    fontname="Helvetica";
    fontsize=10;
    label="queries (abd.rs): no counterexample with up to 0 crashes found, breaks at 1: {crash(Client@0 after queries[Client@0→Replica@1]: Query { rid: 1 })}\nfaults: crash(Client@0 after c59: →Replica@1 Query { rid: 1 })\n— delivered    ⋯ in flight    ╌ ✗ omitted (red) / lost to a crash (gray)";
    h0 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bbbbbb", fontsize=10, height=0.3, label="Replica@0", pos="0.0,0.0!"];
    end0 [shape=point, width=0.04, color="gray55", pos="0.0,-208.0!"];
    h1 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bbbbbb", fontsize=10, height=0.3, label="Replica@1", pos="256.8,0.0!"];
    end1 [shape=point, width=0.04, color="gray55", pos="256.8,-208.0!"];
    h2 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bbbbbb", fontsize=10, height=0.3, label="Replica@2", pos="513.6,0.0!"];
    end2 [shape=point, width=0.04, color="gray55", pos="513.6,-208.0!"];
    h3 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bbbbbb", fontsize=10, height=0.3, label="Client@0", pos="770.4,0.0!"];
    end3 [shape=point, width=0.04, color="gray55", pos="770.4,-208.0!"];
    e0 [shape=point, width=0.08, color="black", pos="770.4,-16.0!"];
    e1 [shape=point, width=0.08, color="black", pos="770.4,-32.0!"];
    crash3 [shape=plaintext, style=filled, fillcolor=white, label="☠ crashed", fontsize=11, margin="0.04,0", height=0.16, pos="770.4,-48.0!"];
    e3 [shape=point, width=0.08, color="gray50", pos="770.4,-64.0!"];
    e4 [shape=point, width=0.08, color="black", pos="0.0,-96.0!"];
    o5 [shape=note, style=filled, fillcolor="#fff7d6", color="gray40", margin="0.05,0.02", height=0.2, label="⇒ (Client@0, Query { rid: 1 })", pos="101.5,-112.0!"];
    e5 [shape=point, width=0.06, color="gray40", pos="0.0,-112.0!"];
    e6 [shape=point, width=0.08, color="black", pos="256.8,-128.0!"];
    o7 [shape=note, style=filled, fillcolor="#fff7d6", color="gray40", margin="0.05,0.02", height=0.2, label="⇒ (Client@0, Query { rid: 1 })", pos="358.3,-144.0!"];
    e7 [shape=point, width=0.06, color="gray40", pos="256.8,-144.0!"];
    e8 [shape=point, width=0.08, color="black", pos="256.8,-160.0!"];
    e9 [shape=point, width=0.08, color="black", pos="0.0,-176.0!"];
    heal_l [shape=point, style=invis, width=0.01, pos="-27.0,-192.0!"];
    heal_r [shape=point, style=invis, width=0.01, pos="806.4,-192.0!"];
    t_heal [label="heal", shape=plaintext, fontcolor="#27ae60", pos="820.4,-192.0!"];
    heal_l -> heal_r [style=dashed, color="#27ae60", arrowhead=none];
    e0 -> e4 [tooltip="c59: Query { rid: 1 }"];
    l0 [shape=plaintext, style=filled, fillcolor=white, fontcolor="black", margin="0.03,0", height=0.14, label="c59: Query { rid: 1 }", pos="642.0,-29.3!"];
    e1 -> e6 [tooltip="c59: Query { rid: 1 }"];
    l1 [shape=plaintext, style=filled, fillcolor=white, fontcolor="black", margin="0.03,0", height=0.14, label="c59: Query { rid: 1 }", pos="642.0,-56.0!"];
    lost2 [shape=plaintext, label="✗", fontcolor="gray50", fontsize=13, width=0.2, height=0.2, fixedsize=true, margin=0, pos="513.6,-80.0!"];
    e3 -> lost2 [tooltip="c59: Query { rid: 1 } (sender crashed)", style=dashed, color="gray50", arrowhead=none];
    l2 [shape=plaintext, style=filled, fillcolor=white, fontcolor="gray50", margin="0.03,0", height=0.14, label="c59: Query { rid: 1 }", pos="642.0,-72.0!"];
    e8 -> end3 [tooltip="c76: QueryResp { rid: 1, reg: None } (in flight)", style=dotted, arrowhead=open];
    l3 [shape=plaintext, style=filled, fillcolor=white, fontcolor="black", margin="0.03,0", height=0.14, label="c76: QueryResp { rid: 1, reg: None }", pos="385.2,-172.0!"];
    e9 -> end3 [tooltip="c76: QueryResp { rid: 1, reg: None } (in flight)", style=dotted, arrowhead=open];
    l4 [shape=plaintext, style=filled, fillcolor=white, fontcolor="black", margin="0.03,0", height=0.14, label="c76: QueryResp { rid: 1, reg: None }", pos="128.4,-181.3!"];
    h0 -> e4 [arrowhead=none, color="gray55"];
    e4 -> e5 [arrowhead=none, color="gray55"];
    e5 -> e9 [arrowhead=none, color="gray55"];
    e9 -> end0 [arrowhead=none, color="gray55"];
    h1 -> e6 [arrowhead=none, color="gray55"];
    e6 -> e7 [arrowhead=none, color="gray55"];
    e7 -> e8 [arrowhead=none, color="gray55"];
    e8 -> end1 [arrowhead=none, color="gray55"];
    h2 -> lost2 [arrowhead=none, color="gray55"];
    lost2 -> end2 [arrowhead=none, color="gray55"];
    h3 -> e0 [arrowhead=none, color="gray55"];
    e0 -> e1 [arrowhead=none, color="gray55"];
    e1 -> crash3 [arrowhead=none, color="gray55"];
    crash3 -> e3 [arrowhead=none, style=dotted, color="gray80"];
    e3 -> end3 [arrowhead=none, style=dotted, color="gray80"];
}
