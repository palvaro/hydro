digraph lamport {
    layout=neato;
    splines=false;
    overlap=true;
    outputorder=edgesfirst;
    pad="0.3,0.2";
    node [fontname="Helvetica", fontsize=9];
    edge [arrowsize=0.7];
    labelloc=t;
    fontname="Helvetica";
    fontsize=10;
    label="known (ec_bruteforce.rs): tolerates 0 crashes, breaks at 1: {crash(Member@0 after net[Member@0→Member@1]: Some(7))}\nfaults: crash(Member@0 after net: →Member@1 Some(7))\n— delivered    ⋯ in flight    ╌ ✗ omitted (red) / lost to a crash (gray)";
    h0 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bbbbbb", fontsize=10, height=0.3, label="Member@0", pos="0.0,0.0!"];
    end0 [shape=point, width=0.04, color="gray55", pos="0.0,-176.0!"];
    h1 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bbbbbb", fontsize=10, height=0.3, label="Member@1", pos="129.6,0.0!"];
    end1 [shape=point, width=0.04, color="gray55", pos="129.6,-176.0!"];
    h2 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bbbbbb", fontsize=10, height=0.3, label="Member@2", pos="259.2,0.0!"];
    end2 [shape=point, width=0.04, color="gray55", pos="259.2,-176.0!"];
    e0 [shape=point, width=0.08, color="black", pos="0.0,-16.0!"];
    crash0 [shape=plaintext, style=filled, fillcolor=white, label="☠ crashed", fontsize=11, margin="0.04,0", height=0.16, pos="0.0,-32.0!"];
    e2 [shape=point, width=0.08, color="gray50", pos="0.0,-48.0!"];
    e3 [shape=point, width=0.08, color="black", pos="129.6,-80.0!"];
    e4 [shape=point, width=0.08, color="black", pos="259.2,-96.0!"];
    e5 [shape=point, width=0.08, color="black", pos="129.6,-112.0!"];
    o6 [shape=note, style=filled, fillcolor="#fff7d6", color="gray40", margin="0.05,0.02", height=0.2, label="⇒ 07000000", pos="178.1,-128.0!"];
    e6 [shape=point, width=0.06, color="gray40", pos="129.6,-128.0!"];
    o7 [shape=note, style=filled, fillcolor="#fff7d6", color="gray40", margin="0.05,0.02", height=0.2, label="⇒ 7", pos="159.5,-144.0!"];
    e7 [shape=point, width=0.06, color="gray40", pos="129.6,-144.0!"];
    heal_l [shape=point, style=invis, width=0.01, pos="-27.0,-160.0!"];
    heal_r [shape=point, style=invis, width=0.01, pos="295.2,-160.0!"];
    t_heal [label="heal", shape=plaintext, fontcolor="#27ae60", pos="309.2,-160.0!"];
    heal_l -> heal_r [style=dashed, color="#27ae60", arrowhead=none];
    e0 -> e3 [tooltip="net: Some(7)"];
    l0 [shape=plaintext, style=filled, fillcolor=white, fontcolor="black", margin="0.03,0", height=0.14, label="net: Some(7)", pos="64.8,-48.0!"];
    lost1 [shape=plaintext, label="✗", fontcolor="gray50", fontsize=13, width=0.2, height=0.2, fixedsize=true, margin=0, pos="259.2,-64.0!"];
    e2 -> lost1 [tooltip="net: Some(7) (sender crashed)", style=dashed, color="gray50", arrowhead=none];
    l1 [shape=plaintext, style=filled, fillcolor=white, fontcolor="gray50", margin="0.03,0", height=0.14, label="net: Some(7)", pos="64.8,-52.0!"];
    e4 -> e5 [tooltip="net: None"];
    l2 [shape=plaintext, style=filled, fillcolor=white, fontcolor="black", margin="0.03,0", height=0.14, label="net: None", pos="194.4,-104.0!"];
    h0 -> e0 [arrowhead=none, color="gray55"];
    e0 -> crash0 [arrowhead=none, color="gray55"];
    crash0 -> e2 [arrowhead=none, style=dotted, color="gray80"];
    e2 -> end0 [arrowhead=none, style=dotted, color="gray80"];
    h1 -> e3 [arrowhead=none, color="gray55"];
    e3 -> e5 [arrowhead=none, color="gray55"];
    e5 -> e6 [arrowhead=none, color="gray55"];
    e6 -> e7 [arrowhead=none, color="gray55"];
    e7 -> end1 [arrowhead=none, color="gray55"];
    h2 -> lost1 [arrowhead=none, color="gray55"];
    lost1 -> e4 [arrowhead=none, color="gray55"];
    e4 -> end2 [arrowhead=none, color="gray55"];
}
