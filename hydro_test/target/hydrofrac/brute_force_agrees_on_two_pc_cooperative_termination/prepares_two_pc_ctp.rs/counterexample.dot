digraph lamport {
    layout=neato;
    splines=false;
    overlap=true;
    outputorder=edgesfirst;
    pad="0.3,0.2";
    node [fontname="Helvetica", fontsize=9];
    edge [arrowsize=0.7];
    labelloc=t;
    fontname="Helvetica";
    fontsize=10;
    label="prepares (two_pc_ctp.rs): no counterexample with up to 0 crashes found, breaks at 1: {crash(Coordinator after prepare[Coordinator→Participant@1]: Txn(1))}\nfaults: crash(Coordinator after prepare: →Participant@1 Txn(1))\n— delivered    ⋯ in flight    ╌ ✗ omitted (red) / lost to a crash (gray)";
    h0 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bbbbbb", fontsize=10, height=0.3, label="Coordinator", pos="0.0,0.0!"];
    end0 [shape=point, width=0.04, color="gray55", pos="0.0,-208.0!"];
    h1 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bbbbbb", fontsize=10, height=0.3, label="Participant@0", pos="145.5,0.0!"];
    end1 [shape=point, width=0.04, color="gray55", pos="145.5,-208.0!"];
    h2 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bbbbbb", fontsize=10, height=0.3, label="Participant@1", pos="291.0,0.0!"];
    end2 [shape=point, width=0.04, color="gray55", pos="291.0,-208.0!"];
    h3 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bbbbbb", fontsize=10, height=0.3, label="Participant@2", pos="436.5,0.0!"];
    end3 [shape=point, width=0.04, color="gray55", pos="436.5,-208.0!"];
    e0 [shape=point, width=0.08, color="black", pos="0.0,-16.0!"];
    e1 [shape=point, width=0.08, color="black", pos="0.0,-32.0!"];
    crash0 [shape=plaintext, style=filled, fillcolor=white, label="☠ crashed", fontsize=11, margin="0.04,0", height=0.16, pos="0.0,-48.0!"];
    e3 [shape=point, width=0.08, color="gray50", pos="0.0,-64.0!"];
    e4 [shape=point, width=0.08, color="black", pos="145.5,-96.0!"];
    o5 [shape=note, style=filled, fillcolor="#fff7d6", color="gray40", margin="0.05,0.02", height=0.2, label="⇒ Txn(1)", pos="188.7,-112.0!"];
    e5 [shape=point, width=0.06, color="gray40", pos="145.5,-112.0!"];
    e6 [shape=point, width=0.08, color="black", pos="291.0,-128.0!"];
    o7 [shape=note, style=filled, fillcolor="#fff7d6", color="gray40", margin="0.05,0.02", height=0.2, label="⇒ Txn(1)", pos="334.2,-144.0!"];
    e7 [shape=point, width=0.06, color="gray40", pos="291.0,-144.0!"];
    e8 [shape=point, width=0.08, color="black", pos="291.0,-160.0!"];
    e9 [shape=point, width=0.08, color="black", pos="145.5,-176.0!"];
    heal_l [shape=point, style=invis, width=0.01, pos="-27.0,-192.0!"];
    heal_r [shape=point, style=invis, width=0.01, pos="472.5,-192.0!"];
    t_heal [label="heal", shape=plaintext, fontcolor="#27ae60", pos="486.5,-192.0!"];
    heal_l -> heal_r [style=dashed, color="#27ae60", arrowhead=none];
    e0 -> e4 [tooltip="prepare: Txn(1)"];
    l0 [shape=plaintext, style=filled, fillcolor=white, fontcolor="black", margin="0.03,0", height=0.14, label="prepare: Txn(1)", pos="72.8,-56.0!"];
    e1 -> e6 [tooltip="prepare: Txn(1)"];
    l1 [shape=plaintext, style=filled, fillcolor=white, fontcolor="black", margin="0.03,0", height=0.14, label="prepare: Txn(1)", pos="72.8,-56.0!"];
    lost2 [shape=plaintext, label="✗", fontcolor="gray50", fontsize=13, width=0.2, height=0.2, fixedsize=true, margin=0, pos="436.5,-80.0!"];
    e3 -> lost2 [tooltip="prepare: Txn(1) (sender crashed)", style=dashed, color="gray50", arrowhead=none];
    l2 [shape=plaintext, style=filled, fillcolor=white, fontcolor="gray50", margin="0.03,0", height=0.14, label="prepare: Txn(1)", pos="72.8,-66.7!"];
    e8 -> end0 [tooltip="vote: Txn(1) (in flight)", style=dotted, arrowhead=open];
    l3 [shape=plaintext, style=filled, fillcolor=white, fontcolor="black", margin="0.03,0", height=0.14, label="vote: Txn(1)", pos="218.2,-172.0!"];
    e9 -> end0 [tooltip="vote: Txn(1) (in flight)", style=dotted, arrowhead=open];
    l4 [shape=plaintext, style=filled, fillcolor=white, fontcolor="black", margin="0.03,0", height=0.14, label="vote: Txn(1)", pos="72.8,-192.0!"];
    h0 -> e0 [arrowhead=none, color="gray55"];
    e0 -> e1 [arrowhead=none, color="gray55"];
    e1 -> crash0 [arrowhead=none, color="gray55"];
    crash0 -> e3 [arrowhead=none, style=dotted, color="gray80"];
    e3 -> end0 [arrowhead=none, style=dotted, color="gray80"];
    h1 -> e4 [arrowhead=none, color="gray55"];
    e4 -> e5 [arrowhead=none, color="gray55"];
    e5 -> e9 [arrowhead=none, color="gray55"];
    e9 -> end1 [arrowhead=none, color="gray55"];
    h2 -> e6 [arrowhead=none, color="gray55"];
    e6 -> e7 [arrowhead=none, color="gray55"];
    e7 -> e8 [arrowhead=none, color="gray55"];
    e8 -> end2 [arrowhead=none, color="gray55"];
    h3 -> lost2 [arrowhead=none, color="gray55"];
    lost2 -> end3 [arrowhead=none, color="gray55"];
}
