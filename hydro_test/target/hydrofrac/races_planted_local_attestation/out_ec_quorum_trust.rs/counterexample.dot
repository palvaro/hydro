digraph lamport {
    layout=neato;
    splines=false;
    overlap=true;
    outputorder=edgesfirst;
    pad="0.3,0.2";
    node [fontname="Helvetica", fontsize=9];
    edge [arrowsize=0.7];
    labelloc=t;
    fontname="Helvetica";
    fontsize=10;
    label="out (ec_quorum_trust.rs): tolerates 0 crashes, breaks at 1: {crash(Source after attestations[Source→Member@0]: 1)}\nfaults: crash(Source after c18: →Member@0 1)\n— delivered    ⋯ in flight    ╌ ✗ omitted (red) / lost to a crash (gray)";
    h0 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bbbbbb", fontsize=10, height=0.3, label="Source", pos="0.0,0.0!"];
    end0 [shape=point, width=0.04, color="gray55", pos="0.0,-192.0!"];
    h1 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bbbbbb", fontsize=10, height=0.3, label="Member@0", pos="108.4,0.0!"];
    end1 [shape=point, width=0.04, color="gray55", pos="108.4,-192.0!"];
    h2 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bbbbbb", fontsize=10, height=0.3, label="Member@1", pos="216.8,0.0!"];
    end2 [shape=point, width=0.04, color="gray55", pos="216.8,-192.0!"];
    e0 [shape=point, width=0.08, color="black", pos="0.0,-16.0!"];
    crash0 [shape=plaintext, style=filled, fillcolor=white, label="☠ crashed", fontsize=11, margin="0.04,0", height=0.16, pos="0.0,-32.0!"];
    e2 [shape=point, width=0.08, color="gray50", pos="0.0,-48.0!"];
    e3 [shape=point, width=0.08, color="black", pos="108.4,-80.0!"];
    o4 [shape=note, style=filled, fillcolor="#fff7d6", color="gray40", margin="0.05,0.02", height=0.2, label="⇒ (1, cluster@0)", pos="172.8,-96.0!"];
    e4 [shape=point, width=0.06, color="gray40", pos="108.4,-96.0!"];
    o5 [shape=note, style=filled, fillcolor="#fff7d6", color="gray40", margin="0.05,0.02", height=0.2, label="⇒ 1", pos="138.3,-112.0!"];
    e5 [shape=point, width=0.06, color="gray40", pos="108.4,-112.0!"];
    o6 [shape=note, style=filled, fillcolor="#fff7d6", color="gray40", margin="0.05,0.02", height=0.2, label="⇒ 01000000", pos="156.9,-128.0!"];
    e6 [shape=point, width=0.06, color="gray40", pos="108.4,-128.0!"];
    o7 [shape=note, style=filled, fillcolor="#fff7d6", color="gray40", margin="0.05,0.02", height=0.2, label="⇒ 1", pos="138.3,-144.0!"];
    e7 [shape=point, width=0.06, color="gray40", pos="108.4,-144.0!"];
    o8 [shape=note, style=filled, fillcolor="#fff7d6", color="gray40", margin="0.05,0.02", height=0.2, label="⇒ Durable { fact: 1 }", pos="186.1,-160.0!"];
    e8 [shape=point, width=0.06, color="gray40", pos="108.4,-160.0!"];
    heal_l [shape=point, style=invis, width=0.01, pos="-27.0,-176.0!"];
    heal_r [shape=point, style=invis, width=0.01, pos="252.8,-176.0!"];
    t_heal [label="heal", shape=plaintext, fontcolor="#27ae60", pos="266.8,-176.0!"];
    heal_l -> heal_r [style=dashed, color="#27ae60", arrowhead=none];
    e0 -> e3 [tooltip="c18: 1"];
    l0 [shape=plaintext, style=filled, fillcolor=white, fontcolor="black", margin="0.03,0", height=0.14, label="c18: 1", pos="54.2,-48.0!"];
    lost1 [shape=plaintext, label="✗", fontcolor="gray50", fontsize=13, width=0.2, height=0.2, fixedsize=true, margin=0, pos="216.8,-64.0!"];
    e2 -> lost1 [tooltip="c18: 1 (sender crashed)", style=dashed, color="gray50", arrowhead=none];
    l1 [shape=plaintext, style=filled, fillcolor=white, fontcolor="gray50", margin="0.03,0", height=0.14, label="c18: 1", pos="54.2,-52.0!"];
    h0 -> e0 [arrowhead=none, color="gray55"];
    e0 -> crash0 [arrowhead=none, color="gray55"];
    crash0 -> e2 [arrowhead=none, style=dotted, color="gray80"];
    e2 -> end0 [arrowhead=none, style=dotted, color="gray80"];
