digraph lamport {
    layout=neato;
    splines=false;
    overlap=true;
    outputorder=edgesfirst;
    pad="0.3,0.2";
    node [fontname="Helvetica", fontsize=9];
    edge [arrowsize=0.7];
    labelloc=t;
    fontname="Helvetica";
    fontsize=10;
    label="delivery (implies.rs): broken: losing the message 1 from Sender to Receiver (on data) leaves Receiver@0 without 1.\nfaults: omit(data: Sender→Receiver 1)\n— delivered    ⋯ in flight    ╌ ✗ omitted (red) / lost to a crash (gray)";
    h0 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bbbbbb", fontsize=10, height=0.3, label="Sender", pos="0.0,0.0!"];
    end0 [shape=point, width=0.04, color="gray55", pos="0.0,-80.0!"];
    h1 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bbbbbb", fontsize=10, height=0.3, label="Receiver", pos="108.4,0.0!"];
    end1 [shape=point, width=0.04, color="gray55", pos="108.4,-80.0!"];
    o0 [shape=note, style=filled, fillcolor="#fff7d6", color="gray40", margin="0.05,0.02", height=0.2, label="⇒ 1", pos="29.9,-16.0!"];
    e0 [shape=point, width=0.06, color="gray40", pos="0.0,-16.0!"];
    e1 [shape=point, width=0.08, color="black", pos="0.0,-32.0!"];
    heal_l [shape=point, style=invis, width=0.01, pos="-27.0,-64.0!"];
    heal_r [shape=point, style=invis, width=0.01, pos="144.4,-64.0!"];
    t_heal [label="heal", shape=plaintext, fontcolor="#27ae60", pos="158.4,-64.0!"];
    heal_l -> heal_r [style=dashed, color="#27ae60", arrowhead=none];
    lost0 [shape=plaintext, label="✗", fontcolor="#c0392b", fontsize=13, width=0.2, height=0.2, fixedsize=true, margin=0, pos="108.4,-48.0!"];
    e1 -> lost0 [tooltip="data: 1 (omitted)", style=dashed, color="#c0392b", arrowhead=none];
    l0 [shape=plaintext, style=filled, fillcolor=white, fontcolor="#c0392b", margin="0.03,0", height=0.14, label="data: 1", pos="54.2,-40.0!"];
    h0 -> e0 [arrowhead=none, color="gray55"];
    e0 -> e1 [arrowhead=none, color="gray55"];
    e1 -> end0 [arrowhead=none, color="gray55"];
    h1 -> lost0 [arrowhead=none, color="gray55"];
    lost0 -> end1 [arrowhead=none, color="gray55"];
}
