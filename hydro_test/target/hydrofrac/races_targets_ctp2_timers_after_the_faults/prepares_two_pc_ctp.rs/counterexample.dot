digraph lamport {
    layout=neato;
    splines=false;
    overlap=true;
    outputorder=edgesfirst;
    pad="0.3,0.2";
    node [fontname="Helvetica", fontsize=9];
    edge [arrowsize=0.7];
    labelloc=t;
    fontname="Helvetica";
    fontsize=10;
    label="prepares (two_pc_ctp.rs): tolerates 0 crashes, breaks at 1: {crash(Coordinator after prepare[Coordinator→Participant@0]: Txn(1))}\nfaults: crash(Coordinator after prepare: →Participant@0 Txn(1))\n— delivered    ⋯ in flight    ╌ ✗ omitted (red) / lost to a crash (gray)";
    h0 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bbbbbb", fontsize=10, height=0.3, label="Coordinator", pos="0.0,0.0!"];
    end0 [shape=point, width=0.04, color="gray55", pos="0.0,-272.0!"];
    h1 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bbbbbb", fontsize=10, height=0.3, label="Participant@0", pos="166.7,0.0!"];
    end1 [shape=point, width=0.04, color="gray55", pos="166.7,-272.0!"];
    h2 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bbbbbb", fontsize=10, height=0.3, label="Participant@1", pos="333.4,0.0!"];
    end2 [shape=point, width=0.04, color="gray55", pos="333.4,-272.0!"];
    e0 [shape=point, width=0.08, color="black", pos="0.0,-16.0!"];
    crash0 [shape=plaintext, style=filled, fillcolor=white, label="☠ crashed", fontsize=11, margin="0.04,0", height=0.16, pos="0.0,-32.0!"];
    e2 [shape=point, width=0.08, color="gray50", pos="0.0,-48.0!"];
    e3 [shape=point, width=0.08, color="black", pos="166.7,-80.0!"];
    o4 [shape=note, style=filled, fillcolor="#fff7d6", color="gray40", margin="0.05,0.02", height=0.2, label="⇒ Txn(1)", pos="209.9,-96.0!"];
    e4 [shape=point, width=0.06, color="gray40", pos="166.7,-96.0!"];
    e5 [shape=point, width=0.08, color="black", pos="166.7,-112.0!"];
    heal_l [shape=point, style=invis, width=0.01, pos="-27.0,-128.0!"];
    heal_r [shape=point, style=invis, width=0.01, pos="369.4,-128.0!"];
    t_heal [label="heal", shape=plaintext, fontcolor="#27ae60", pos="383.4,-128.0!"];
    heal_l -> heal_r [style=dashed, color="#27ae60", arrowhead=none];
    e7 [shape=point, width=0.08, color="black", pos="166.7,-144.0!"];
    e8 [shape=point, width=0.08, color="black", pos="166.7,-160.0!"];
    e9 [shape=point, width=0.08, color="black", pos="166.7,-176.0!"];
    o10 [shape=note, style=filled, fillcolor="#fff7d6", color="gray40", margin="0.05,0.02", height=0.2, label="⇒ (Participant@0, Query(Txn(1)))", pos="273.5,-192.0!"];
    e10 [shape=point, width=0.06, color="gray40", pos="166.7,-192.0!"];
    o11 [shape=note, style=filled, fillcolor="#fff7d6", color="gray40", margin="0.05,0.02", height=0.2, label="⇒ (Participant@0, Query(Txn(1)))", pos="273.5,-208.0!"];
    e11 [shape=point, width=0.06, color="gray40", pos="166.7,-208.0!"];
    e12 [shape=point, width=0.08, color="black", pos="333.4,-224.0!"];
    o13 [shape=note, style=filled, fillcolor="#fff7d6", color="gray40", margin="0.05,0.02", height=0.2, label="⇒ (Participant@0, Query(Txn(1)))", pos="440.2,-240.0!"];
    e13 [shape=point, width=0.06, color="gray40", pos="333.4,-240.0!"];
    o14 [shape=note, style=filled, fillcolor="#fff7d6", color="gray40", margin="0.05,0.02", height=0.2, label="⇒ (Participant@0, Query(Txn(1)))", pos="440.2,-256.0!"];
    e14 [shape=point, width=0.06, color="gray40", pos="333.4,-256.0!"];
    e0 -> e3 [tooltip="prepare: Txn(1)"];
    l0 [shape=plaintext, style=filled, fillcolor=white, fontcolor="black", margin="0.03,0", height=0.14, label="prepare: Txn(1)", pos="83.3,-48.0!"];
    lost1 [shape=plaintext, label="✗", fontcolor="gray50", fontsize=13, width=0.2, height=0.2, fixedsize=true, margin=0, pos="333.4,-64.0!"];
    e2 -> lost1 [tooltip="prepare: Txn(1) (sender crashed)", style=dashed, color="gray50", arrowhead=none];
    l1 [shape=plaintext, style=filled, fillcolor=white, fontcolor="gray50", margin="0.03,0", height=0.14, label="prepare: Txn(1)", pos="83.3,-52.0!"];
    e5 -> end0 [tooltip="vote: Txn(1) (in flight)", style=dotted, arrowhead=open];
    l2 [shape=plaintext, style=filled, fillcolor=white, fontcolor="black", margin="0.03,0", height=0.14, label="vote: Txn(1)", pos="83.3,-192.0!"];
    via3 [shape=point, style=invis, width=0.01, pos="180.7,-160.0!"];
    e7 -> via3 [tooltip="peer: Query(Txn(1))", arrowhead=none];
    via3 -> e9 [tooltip="peer: Query(Txn(1))"];
    l3 [shape=plaintext, style=filled, fillcolor=white, fontcolor="black", margin="0.03,0", height=0.14, label="peer: Query(Txn(1))", pos="236.0,-160.0!"];
    e8 -> e12 [tooltip="peer: Query(Txn(1))"];
    l4 [shape=plaintext, style=filled, fillcolor=white, fontcolor="black", margin="0.03,0", height=0.14, label="peer: Query(Txn(1))", pos="250.0,-192.0!"];
    h0 -> e0 [arrowhead=none, color="gray55"];
    e0 -> crash0 [arrowhead=none, color="gray55"];
    crash0 -> e2 [arrowhead=none, style=dotted, color="gray80"];
    e2 -> end0 [arrowhead=none, style=dotted, color="gray80"];
    h1 -> e3 [arrowhead=none, color="gray55"];
    e3 -> e4 [arrowhead=none, color="gray55"];
    e4 -> e5 [arrowhead=none, color="gray55"];
    e5 -> e7 [arrowhead=none, color="gray55"];
    e7 -> e8 [arrowhead=none, color="gray55"];
    e8 -> e9 [arrowhead=none, color="gray55"];
    e9 -> e10 [arrowhead=none, color="gray55"];
    e10 -> e11 [arrowhead=none, color="gray55"];
    e11 -> end1 [arrowhead=none, color="gray55"];
    h2 -> lost1 [arrowhead=none, color="gray55"];
    lost1 -> e12 [arrowhead=none, color="gray55"];
    e12 -> e13 [arrowhead=none, color="gray55"];
    e13 -> e14 [arrowhead=none, color="gray55"];
    e14 -> end2 [arrowhead=none, color="gray55"];
}
