source: hydro_test/src/cluster/ldfi_viz.rs
expression: dot
---
digraph provenance {
    rankdir=TB;
    compound=true;
    node [fontname="Helvetica", fontsize=10];
    edge [fontname="Helvetica", fontsize=8];
    label="2PC, failure-free run, slice-level lineage"; labelloc=t; fontname="Helvetica";
