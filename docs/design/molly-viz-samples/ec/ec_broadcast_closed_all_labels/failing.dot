digraph lamport {
    layout=neato;
    splines=false;
    overlap=true;
    outputorder=edgesfirst;
    pad="0.3,0.2";
    node [fontname="Helvetica", fontsize=10];
    edge [fontname="Helvetica", fontsize=9];
    labelloc=t;
    fontname="Helvetica";
    label=<<FONT POINT-SIZE="12">goal violated by {crash(source after bcast[→1]:Item(2))}</FONT><BR/><FONT POINT-SIZE="8" COLOR="gray40">— delivered    ⋯ in flight    ╌ ✗ omitted (red) / lost to a crash (gray)    ★ support</FONT>>;
    // lanes
    h0 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bbbbbb", height=0.3, label="source", pos="0.0,0.0!"];
    h1 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bbbbbb", height=0.3, label="member@0", pos="140.2,0.0!"];
    h2 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bbbbbb", height=0.3, label="member@1", pos="280.4,0.0!"];
    h3 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bbbbbb", height=0.3, label="member@2", pos="420.6,0.0!"];
    e1 [shape=point, width=0.08, color="black", pos="0.0,-16.0!"];
    e2 [shape=point, width=0.08, color="black", pos="0.0,-32.0!"];
    e3 [shape=point, width=0.08, color="black", pos="0.0,-48.0!"];
    e4 [shape=point, width=0.08, color="black", pos="0.0,-64.0!"];
    e5 [shape=point, width=0.08, color="black", pos="0.0,-80.0!"];
    crash0 [shape=plaintext, style=filled, fillcolor=white, label="☠ crashed", fontsize=11, margin="0.04,0", height=0.16, pos="0.0,-96.0!"];
    e6 [shape=point, width=0.08, color="gray50", pos="0.0,-112.0!"];
    lost5 [shape=plaintext, label="✗", fontcolor="gray50", fontsize=13, width=0.2, height=0.2, fixedsize=true, margin=0, pos="420.6,-128.0!"];
    e9 [shape=point, width=0.08, color="black", pos="140.2,-144.0!"];
    e10 [shape=point, width=0.06, color="gray40", pos="140.2,-160.0!"];
    e12 [shape=point, width=0.08, color="black", pos="140.2,-176.0!"];
    e13 [shape=point, width=0.06, color="gray40", pos="140.2,-192.0!"];
    e16 [shape=point, width=0.08, color="black", pos="280.4,-208.0!"];
    e17 [shape=point, width=0.06, color="gray40", pos="280.4,-224.0!"];
    e19 [shape=point, width=0.08, color="black", pos="280.4,-240.0!"];
    e20 [shape=point, width=0.06, color="gray40", pos="280.4,-256.0!"];
    e23 [shape=point, width=0.08, color="black", pos="420.6,-272.0!"];
    e24 [shape=point, width=0.06, color="gray40", pos="420.6,-288.0!"];
    end0 [shape=point, width=0.04, color="gray55", pos="0.0,-304.0!"];
    end1 [shape=point, width=0.04, color="gray55", pos="140.2,-304.0!"];
    end2 [shape=point, width=0.04, color="gray55", pos="280.4,-304.0!"];
    end3 [shape=point, width=0.04, color="gray55", pos="420.6,-304.0!"];
    h0 -> e1 [arrowhead=none, color="gray55"];
    e1 -> e2 [arrowhead=none, color="gray55"];
    e2 -> e3 [arrowhead=none, color="gray55"];
    e3 -> e4 [arrowhead=none, color="gray55"];
    e4 -> e5 [arrowhead=none, color="gray55"];
    e5 -> crash0 [arrowhead=none, color="gray55"];
    crash0 -> e6 [arrowhead=none, style=dotted, color="gray80"];
    e6 -> end0 [arrowhead=none, style=dotted, color="gray80"];
    h1 -> e9 [arrowhead=none, color="gray55"];
    e9 -> e10 [arrowhead=none, color="gray55"];
    e10 -> e12 [arrowhead=none, color="gray55"];
    e12 -> e13 [arrowhead=none, color="gray55"];
    e13 -> end1 [arrowhead=none, color="gray55"];
    h2 -> e16 [arrowhead=none, color="gray55"];
    e16 -> e17 [arrowhead=none, color="gray55"];
    e17 -> e19 [arrowhead=none, color="gray55"];
    e19 -> e20 [arrowhead=none, color="gray55"];
    e20 -> end2 [arrowhead=none, color="gray55"];
    h3 -> lost5 [arrowhead=none, color="gray55"];
    lost5 -> e23 [arrowhead=none, color="gray55"];
    e23 -> e24 [arrowhead=none, color="gray55"];
    e24 -> end3 [arrowhead=none, color="gray55"];
    // outputs
    o10 [shape=note, fontsize=9, style=filled, fillcolor="#fff7d6", color="gray40", margin="0.05,0.02", height=0.2, label="⇒ 01000000", pos="178.7,-160.0!"];
    o13 [shape=note, fontsize=9, style=filled, fillcolor="#fff7d6", color="gray40", margin="0.05,0.02", height=0.2, label="⇒ 02000000", pos="178.7,-192.0!"];
    o17 [shape=note, fontsize=9, style=filled, fillcolor="#fff7d6", color="gray40", margin="0.05,0.02", height=0.2, label="⇒ 01000000", pos="318.9,-224.0!"];
    o20 [shape=note, fontsize=9, style=filled, fillcolor="#fff7d6", color="gray40", margin="0.05,0.02", height=0.2, label="⇒ 02000000", pos="318.9,-256.0!"];
    o24 [shape=note, fontsize=9, style=filled, fillcolor="#fff7d6", color="gray40", margin="0.05,0.02", height=0.2, label="⇒ 01000000", pos="459.1,-288.0!"];
    // messages
    e1 -> e9 [tooltip="bcast: Item(1)", arrowsize=0.7];
    e2 -> e16 [tooltip="bcast: Item(1)", arrowsize=0.7];
    e3 -> e23 [tooltip="bcast: Item(1)", arrowsize=0.7];
    e4 -> e12 [tooltip="bcast: Item(2)", arrowsize=0.7];
    e5 -> e19 [tooltip="bcast: Item(2)", arrowsize=0.7];
    e6 -> lost5 [tooltip="bcast: Item(2) (sender crashed)", style=dashed, color="gray50", arrowhead=none];
    // message labels
    l0 [shape=plaintext, style=filled, fillcolor=white, fontsize=9, fontcolor="black", margin="0.03,0", height=0.14, label="bcast: Item(1)", pos="70.1,-80.0!"];
    l1 [shape=plaintext, style=filled, fillcolor=white, fontsize=9, fontcolor="black", margin="0.03,0", height=0.14, label="bcast: Item(1)", pos="70.1,-76.0!"];
    l2 [shape=plaintext, style=filled, fillcolor=white, fontsize=9, fontcolor="black", margin="0.03,0", height=0.14, label="bcast: Item(1)", pos="364.5,-242.1!"];
    l3 [shape=plaintext, style=filled, fillcolor=white, fontsize=9, fontcolor="black", margin="0.03,0", height=0.14, label="bcast: Item(2)", pos="70.1,-120.0!"];
    l4 [shape=plaintext, style=filled, fillcolor=white, fontsize=9, fontcolor="black", margin="0.03,0", height=0.14, label="bcast: Item(2)", pos="224.3,-208.0!"];
    l5 [shape=plaintext, style=filled, fillcolor=white, fontsize=9, fontcolor="gray50", margin="0.03,0", height=0.14, label="bcast: Item(2)", pos="210.3,-120.0!"];
}
