digraph lamport {
    layout=neato;
    splines=false;
    overlap=true;
    outputorder=edgesfirst;
    pad="0.3,0.2";
    node [fontname="Helvetica", fontsize=10];
    edge [fontname="Helvetica", fontsize=9];
    labelloc=t;
    fontname="Helvetica";
    label=<<FONT POINT-SIZE="12">goal violated by {omit(bcast[→0]:Item(1))}</FONT><BR/><FONT POINT-SIZE="8" COLOR="gray40">— delivered    ⋯ in flight    ╌ ✗ omitted (red) / lost to a crash (gray)    ★ support</FONT>>;
    // lanes
    h0 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bbbbbb", height=0.3, label="source", pos="0.0,0.0!"];
    h1 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bbbbbb", height=0.3, label="member@0", pos="140.2,0.0!"];
    h2 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bbbbbb", height=0.3, label="member@1", pos="280.4,0.0!"];
    h3 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bbbbbb", height=0.3, label="member@2", pos="420.6,0.0!"];
    e1 [shape=point, width=0.08, color="black", pos="0.0,-16.0!"];
    lost0 [shape=plaintext, label="✗", fontcolor="#c0392b", fontsize=13, width=0.2, height=0.2, fixedsize=true, margin=0, pos="140.2,-32.0!"];
    e2 [shape=point, width=0.08, color="black", pos="0.0,-48.0!"];
    e3 [shape=point, width=0.08, color="black", pos="0.0,-64.0!"];
    e4 [shape=point, width=0.08, color="black", pos="0.0,-80.0!"];
    e5 [shape=point, width=0.08, color="black", pos="0.0,-96.0!"];
    e6 [shape=point, width=0.08, color="black", pos="0.0,-112.0!"];
    e9 [shape=point, width=0.08, color="black", pos="140.2,-128.0!"];
    e12 [shape=point, width=0.08, color="black", pos="280.4,-144.0!"];
    e14 [shape=point, width=0.08, color="black", pos="280.4,-160.0!"];
    e17 [shape=point, width=0.08, color="black", pos="420.6,-176.0!"];
    e19 [shape=point, width=0.08, color="black", pos="420.6,-192.0!"];
    end0 [shape=point, width=0.04, color="gray55", pos="0.0,-208.0!"];
    end1 [shape=point, width=0.04, color="gray55", pos="140.2,-208.0!"];
    end2 [shape=point, width=0.04, color="gray55", pos="280.4,-208.0!"];
    end3 [shape=point, width=0.04, color="gray55", pos="420.6,-208.0!"];
    h0 -> e1 [arrowhead=none, color="gray55"];
    e1 -> e2 [arrowhead=none, color="gray55"];
    e2 -> e3 [arrowhead=none, color="gray55"];
    e3 -> e4 [arrowhead=none, color="gray55"];
    e4 -> e5 [arrowhead=none, color="gray55"];
    e5 -> e6 [arrowhead=none, color="gray55"];
    e6 -> end0 [arrowhead=none, color="gray55"];
    h1 -> lost0 [arrowhead=none, color="gray55"];
    lost0 -> e9 [arrowhead=none, color="gray55"];
    e9 -> end1 [arrowhead=none, color="gray55"];
    h2 -> e12 [arrowhead=none, color="gray55"];
    e12 -> e14 [arrowhead=none, color="gray55"];
    e14 -> end2 [arrowhead=none, color="gray55"];
    h3 -> e17 [arrowhead=none, color="gray55"];
    e17 -> e19 [arrowhead=none, color="gray55"];
    e19 -> end3 [arrowhead=none, color="gray55"];
    // messages
    e1 -> lost0 [tooltip="bcast: Item(1) (omitted)", style=dashed, color="#c0392b", arrowhead=none];
    e2 -> e12 [tooltip="bcast: Item(1)", arrowsize=0.7];
    e3 -> e17 [tooltip="bcast: Item(1)", arrowsize=0.7];
    e4 -> e9 [tooltip="bcast: Item(2)", arrowsize=0.7];
    e5 -> e14 [tooltip="bcast: Item(2)", arrowsize=0.7];
    e6 -> e19 [tooltip="bcast: Item(2)", arrowsize=0.7];
    // message labels
    l0 [shape=plaintext, style=filled, fillcolor=white, fontsize=9, fontcolor="#c0392b", margin="0.03,0", height=0.14, label="bcast: Item(1)", pos="70.1,-24.0!"];
    l1 [shape=plaintext, style=filled, fillcolor=white, fontsize=9, fontcolor="black", margin="0.03,0", height=0.14, label="bcast: Item(1)", pos="70.1,-60.0!"];
    l2 [shape=plaintext, style=filled, fillcolor=white, fontsize=9, fontcolor="black", margin="0.03,0", height=0.14, label="bcast: Item(1)", pos="350.5,-157.3!"];
    l3 [shape=plaintext, style=filled, fillcolor=white, fontsize=9, fontcolor="black", margin="0.03,0", height=0.14, label="bcast: Item(2)", pos="70.1,-104.0!"];
    l4 [shape=plaintext, style=filled, fillcolor=white, fontsize=9, fontcolor="black", margin="0.03,0", height=0.14, label="bcast: Item(2)", pos="70.1,-112.0!"];
    l5 [shape=plaintext, style=filled, fillcolor=white, fontsize=9, fontcolor="black", margin="0.03,0", height=0.14, label="bcast: Item(2)", pos="350.5,-178.7!"];
}
