digraph lamport {
    layout=neato;
    splines=false;
    overlap=true;
    outputorder=edgesfirst;
    pad="0.3,0.2";
    node [fontname="Helvetica", fontsize=10];
    edge [fontname="Helvetica", fontsize=9];
    labelloc=t;
    fontname="Helvetica";
    label=<<FONT POINT-SIZE="12">goal violated by {crash(source@0 after bcast[0→1]:Item(10))}</FONT><BR/><FONT POINT-SIZE="8" COLOR="gray40">— delivered    ⋯ in flight    ╌ ✗ omitted (red) / lost to a crash (gray)    ★ support</FONT>>;
    // lanes
    h0 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bbbbbb", height=0.3, label="source@0", pos="0.0,0.0!"];
    h4 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bbbbbb", height=0.3, label="source@1", pos="145.5,0.0!"];
    h1 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bbbbbb", height=0.3, label="member@0", pos="291.0,0.0!"];
    h2 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bbbbbb", height=0.3, label="member@1", pos="436.5,0.0!"];
    h3 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bbbbbb", height=0.3, label="member@2", pos="582.0,0.0!"];
    e2 [shape=point, width=0.08, color="black", pos="0.0,-16.0!"];
    e3 [shape=point, width=0.08, color="black", pos="0.0,-32.0!"];
    crash0 [shape=plaintext, style=filled, fillcolor=white, label="☠ crashed", fontsize=11, margin="0.04,0", height=0.16, pos="0.0,-48.0!"];
    e4 [shape=point, width=0.08, color="gray50", pos="0.0,-64.0!"];
    lost2 [shape=plaintext, label="✗", fontcolor="gray50", fontsize=13, width=0.2, height=0.2, fixedsize=true, margin=0, pos="582.0,-80.0!"];
    e6 [shape=point, width=0.08, color="black", pos="145.5,-96.0!"];
    e7 [shape=point, width=0.08, color="black", pos="145.5,-112.0!"];
    e8 [shape=point, width=0.08, color="black", pos="145.5,-128.0!"];
    e10 [shape=point, width=0.08, color="black", pos="291.0,-144.0!"];
    e12 [shape=point, width=0.08, color="black", pos="291.0,-160.0!"];
    e15 [shape=point, width=0.08, color="black", pos="436.5,-176.0!"];
    e17 [shape=point, width=0.08, color="black", pos="436.5,-192.0!"];
    e20 [shape=point, width=0.08, color="black", pos="582.0,-208.0!"];
    end0 [shape=point, width=0.04, color="gray55", pos="0.0,-224.0!"];
    end4 [shape=point, width=0.04, color="gray55", pos="145.5,-224.0!"];
    end1 [shape=point, width=0.04, color="gray55", pos="291.0,-224.0!"];
    end2 [shape=point, width=0.04, color="gray55", pos="436.5,-224.0!"];
    end3 [shape=point, width=0.04, color="gray55", pos="582.0,-224.0!"];
    h0 -> e2 [arrowhead=none, color="gray55"];
    e2 -> e3 [arrowhead=none, color="gray55"];
    e3 -> crash0 [arrowhead=none, color="gray55"];
    crash0 -> e4 [arrowhead=none, style=dotted, color="gray80"];
    e4 -> end0 [arrowhead=none, style=dotted, color="gray80"];
    h4 -> e6 [arrowhead=none, color="gray55"];
    e6 -> e7 [arrowhead=none, color="gray55"];
    e7 -> e8 [arrowhead=none, color="gray55"];
    e8 -> end4 [arrowhead=none, color="gray55"];
    h1 -> e10 [arrowhead=none, color="gray55"];
    e10 -> e12 [arrowhead=none, color="gray55"];
    e12 -> end1 [arrowhead=none, color="gray55"];
    h2 -> e15 [arrowhead=none, color="gray55"];
    e15 -> e17 [arrowhead=none, color="gray55"];
    e17 -> end2 [arrowhead=none, color="gray55"];
    h3 -> lost2 [arrowhead=none, color="gray55"];
    lost2 -> e20 [arrowhead=none, color="gray55"];
    e20 -> end3 [arrowhead=none, color="gray55"];
    // messages
    e2 -> e10 [tooltip="bcast: Item(10)", arrowsize=0.7];
    e3 -> e15 [tooltip="bcast: Item(10)", arrowsize=0.7];
    e4 -> lost2 [tooltip="bcast: Item(10) (sender crashed)", style=dashed, color="gray50", arrowhead=none];
    e6 -> e12 [tooltip="bcast: Item(20)", arrowsize=0.7];
    e7 -> e17 [tooltip="bcast: Item(20)", arrowsize=0.7];
    e8 -> e20 [tooltip="bcast: Item(20)", arrowsize=0.7];
    // message labels
    l0 [shape=plaintext, style=filled, fillcolor=white, fontsize=9, fontcolor="black", margin="0.03,0", height=0.14, label="bcast: Item(10)", pos="58.2,-29.6!"];
    l1 [shape=plaintext, style=filled, fillcolor=white, fontsize=9, fontcolor="black", margin="0.03,0", height=0.14, label="bcast: Item(10)", pos="363.8,-152.0!"];
    l2 [shape=plaintext, style=filled, fillcolor=white, fontsize=9, fontcolor="gray50", margin="0.03,0", height=0.14, label="bcast: Item(10)", pos="218.2,-70.0!"];
    l3 [shape=plaintext, style=filled, fillcolor=white, fontsize=9, fontcolor="black", margin="0.03,0", height=0.14, label="bcast: Item(20)", pos="218.2,-128.0!"];
    l4 [shape=plaintext, style=filled, fillcolor=white, fontsize=9, fontcolor="black", margin="0.03,0", height=0.14, label="bcast: Item(20)", pos="363.8,-184.0!"];
    l5 [shape=plaintext, style=filled, fillcolor=white, fontsize=9, fontcolor="black", margin="0.03,0", height=0.14, label="bcast: Item(20)", pos="509.2,-194.7!"];
}
