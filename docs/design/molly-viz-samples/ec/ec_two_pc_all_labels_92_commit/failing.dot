    via15 -> e108 [tooltip="peer: Decided(Txn(1))", arrowsize=0.7];
    e85 -> e110 [tooltip="peer: Decided(Txn(1))", arrowsize=0.7];
    // message labels
    l0 [shape=plaintext, style=filled, fillcolor=white, fontsize=9, fontcolor="black", margin="0.03,0", height=0.14, label="prepare: Txn(1)", pos="88.7,-32.0!"];
    l1 [shape=plaintext, style=filled, fillcolor=white, fontsize=9, fontcolor="black", margin="0.03,0", height=0.14, label="prepare: Txn(1)", pos="266.0,-68.0!"];
