    l5 [shape=plaintext, style=filled, fillcolor=white, fontsize=9, fontcolor="black", margin="0.03,0", height=0.14, label="vote: Txn(1)", pos="266.0,-104.0!"];
    l6 [shape=plaintext, style=filled, fillcolor=white, fontsize=9, fontcolor="black", margin="0.03,0", height=0.14, label="commit: Txn(1)", pos="88.7,-188.0!"];
    l7 [shape=plaintext, style=filled, fillcolor=white, fontsize=9, fontcolor="gray50", margin="0.03,0", height=0.14, label="commit: Txn(1)", pos="266.0,-188.0!"];
    l9 [shape=plaintext, style=filled, fillcolor=white, fontsize=9, fontcolor="black", margin="0.03,0", height=0.14, label="peer: Query(Txn(1))", pos="266.0,-264.0!"];
    l10 [shape=plaintext, style=filled, fillcolor=white, fontsize=9, fontcolor="black", margin="0.03,0", height=0.14, label="peer: Query(Txn(1))", pos="285.2,-264.0!"];
    l15 [shape=plaintext, style=filled, fillcolor=white, fontsize=9, fontcolor="black", margin="0.03,0", height=0.14, label="peer: Decided(Txn(1))", pos="252.0,-320.0!"];
    l16 [shape=plaintext, style=filled, fillcolor=white, fontsize=9, fontcolor="black", margin="0.03,0", height=0.14, label="peer: Decided(Txn(1))", pos="266.0,-336.0!"];
}
