    o112 [shape=note, fontsize=9, style=filled, fillcolor="#fff7d6", color="gray40", margin="0.05,0.02", height=0.2, label="⇒ 01000000", pos="393.1,-368.0!"];
    // messages
    e1 -> e19 [tooltip="prepare: Txn(1)", arrowsize=0.7];
    e2 -> e25 [tooltip="prepare: Txn(1)", arrowsize=0.7];
    e21 -> e31 [tooltip="vote: Txn(1)", arrowsize=0.7];
    e27 -> e32 [tooltip="vote: Txn(1)", arrowsize=0.7];
    e34 -> e47 [tooltip="commit: Txn(1)", arrowsize=0.7];
    e35 -> lost7 [tooltip="commit: Txn(1) (sender crashed)", style=dashed, color="gray50", arrowhead=none];
    e55 -> e82 [tooltip="peer: Query(Txn(1))", arrowsize=0.7];
    via10 [shape=point, style=invis, width=0.01, pos="340.6,-264.0!"];
    e56 -> via10 [tooltip="peer: Query(Txn(1))", arrowhead=none];
    via10 -> e80 [tooltip="peer: Query(Txn(1))", arrowsize=0.7];
