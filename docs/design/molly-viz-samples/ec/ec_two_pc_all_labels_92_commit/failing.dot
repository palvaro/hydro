    e34 [shape=point, width=0.08, color="black", pos="0.0,-144.0!"];
    crash0 [shape=plaintext, style=filled, fillcolor=white, label="☠ crashed", fontsize=11, margin="0.04,0", height=0.16, pos="0.0,-160.0!"];
    e35 [shape=point, width=0.08, color="gray50", pos="0.0,-176.0!"];
    lost7 [shape=plaintext, label="✗", fontcolor="gray50", fontsize=13, width=0.2, height=0.2, fixedsize=true, margin=0, pos="354.6,-192.0!"];
    e47 [shape=point, width=0.08, color="black", pos="177.3,-208.0!"];
    e49 [shape=point, width=0.06, color="gray40", pos="177.3,-224.0!"];
    e55 [shape=point, width=0.08, color="black", pos="354.6,-240.0!"];
    e56 [shape=point, width=0.08, color="black", pos="354.6,-256.0!"];
    e80 [shape=point, width=0.08, color="black", pos="354.6,-272.0!"];
    e82 [shape=point, width=0.08, color="black", pos="177.3,-288.0!"];
    e84 [shape=point, width=0.08, color="black", pos="177.3,-304.0!"];
    e85 [shape=point, width=0.08, color="black", pos="177.3,-320.0!"];
    e108 [shape=point, width=0.08, color="black", pos="177.3,-336.0!"];
    e110 [shape=point, width=0.08, color="black", pos="354.6,-352.0!"];
    e112 [shape=point, width=0.06, color="gray40", pos="354.6,-368.0!"];
    end0 [shape=point, width=0.04, color="gray55", pos="0.0,-384.0!"];
    end1 [shape=point, width=0.04, color="gray55", pos="177.3,-384.0!"];
    end2 [shape=point, width=0.04, color="gray55", pos="354.6,-384.0!"];
    h0 -> e1 [arrowhead=none, color="gray55"];
    e1 -> e2 [arrowhead=none, color="gray55"];
    e2 -> e31 [arrowhead=none, color="gray55"];
    e31 -> e32 [arrowhead=none, color="gray55"];
    e32 -> e34 [arrowhead=none, color="gray55"];
    e34 -> crash0 [arrowhead=none, color="gray55"];
    crash0 -> e35 [arrowhead=none, style=dotted, color="gray80"];
    e35 -> end0 [arrowhead=none, style=dotted, color="gray80"];
    h1 -> e19 [arrowhead=none, color="gray55"];
    e19 -> e21 [arrowhead=none, color="gray55"];
    e21 -> e47 [arrowhead=none, color="gray55"];
    e47 -> e49 [arrowhead=none, color="gray55"];
    e49 -> e82 [arrowhead=none, color="gray55"];
    e82 -> e84 [arrowhead=none, color="gray55"];
    e84 -> e85 [arrowhead=none, color="gray55"];
    e85 -> e108 [arrowhead=none, color="gray55"];
    e108 -> end1 [arrowhead=none, color="gray55"];
    h2 -> e25 [arrowhead=none, color="gray55"];
    e25 -> e27 [arrowhead=none, color="gray55"];
    e27 -> lost7 [arrowhead=none, color="gray55"];
    lost7 -> e55 [arrowhead=none, color="gray55"];
    e55 -> e56 [arrowhead=none, color="gray55"];
    e56 -> e80 [arrowhead=none, color="gray55"];
    e80 -> e110 [arrowhead=none, color="gray55"];
    e110 -> e112 [arrowhead=none, color="gray55"];
    e112 -> end2 [arrowhead=none, color="gray55"];
