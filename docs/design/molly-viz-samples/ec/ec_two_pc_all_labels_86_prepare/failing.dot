digraph lamport {
    layout=neato;
    splines=false;
    overlap=true;
    outputorder=edgesfirst;
    pad="0.3,0.2";
    node [fontname="Helvetica", fontsize=10];
    edge [fontname="Helvetica", fontsize=9];
    labelloc=t;
    fontname="Helvetica";
    label=<<FONT POINT-SIZE="12">goal violated by {crash(coordinator after prepare[→0]:Txn(1))}</FONT><BR/><FONT POINT-SIZE="8" COLOR="gray40">— delivered    ⋯ in flight    ╌ ✗ omitted (red) / lost to a crash (gray)    ★ support</FONT>>;
    // lanes
    h0 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bbbbbb", height=0.3, label="coordinator", pos="0.0,0.0!"];
    h1 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bbbbbb", height=0.3, label="participant@0", pos="166.7,0.0!"];
    h2 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bbbbbb", height=0.3, label="participant@1", pos="333.4,0.0!"];
    e1 [shape=point, width=0.08, color="black", pos="0.0,-16.0!"];
    crash0 [shape=plaintext, style=filled, fillcolor=white, label="☠ crashed", fontsize=11, margin="0.04,0", height=0.16, pos="0.0,-32.0!"];
    e2 [shape=point, width=0.08, color="gray50", pos="0.0,-48.0!"];
    lost1 [shape=plaintext, label="✗", fontcolor="gray50", fontsize=13, width=0.2, height=0.2, fixedsize=true, margin=0, pos="333.4,-64.0!"];
    e16 [shape=point, width=0.08, color="black", pos="166.7,-80.0!"];
    e18 [shape=point, width=0.08, color="black", pos="166.7,-96.0!"];
    e22 [shape=point, width=0.08, color="gray50", pos="0.0,-112.0!"];
    e27 [shape=point, width=0.08, color="black", pos="166.7,-128.0!"];
    e28 [shape=point, width=0.08, color="black", pos="166.7,-144.0!"];
    e51 [shape=point, width=0.08, color="black", pos="333.4,-160.0!"];
    e53 [shape=point, width=0.08, color="black", pos="166.7,-176.0!"];
    end0 [shape=point, width=0.04, color="gray55", pos="0.0,-192.0!"];
    end1 [shape=point, width=0.04, color="gray55", pos="166.7,-192.0!"];
    end2 [shape=point, width=0.04, color="gray55", pos="333.4,-192.0!"];
    h0 -> e1 [arrowhead=none, color="gray55"];
    e1 -> crash0 [arrowhead=none, color="gray55"];
    crash0 -> e2 [arrowhead=none, style=dotted, color="gray80"];
    e2 -> e22 [arrowhead=none, style=dotted, color="gray80"];
    e22 -> end0 [arrowhead=none, style=dotted, color="gray80"];
    h1 -> e16 [arrowhead=none, color="gray55"];
    e16 -> e18 [arrowhead=none, color="gray55"];
    e18 -> e27 [arrowhead=none, color="gray55"];
    e27 -> e28 [arrowhead=none, color="gray55"];
    e28 -> e53 [arrowhead=none, color="gray55"];
    e53 -> end1 [arrowhead=none, color="gray55"];
    h2 -> lost1 [arrowhead=none, color="gray55"];
    lost1 -> e51 [arrowhead=none, color="gray55"];
    e51 -> end2 [arrowhead=none, color="gray55"];
    // messages
    e1 -> e16 [tooltip="prepare: Txn(1)", arrowsize=0.7];
    e2 -> lost1 [tooltip="prepare: Txn(1) (sender crashed)", style=dashed, color="gray50", arrowhead=none];
    e18 -> e22 [tooltip="vote: Txn(1)", arrowsize=0.7];
    via4 [shape=point, style=invis, width=0.01, pos="180.7,-152.0!"];
    e27 -> via4 [tooltip="peer: Query(Txn(1))", arrowhead=none];
    via4 -> e53 [tooltip="peer: Query(Txn(1))", arrowsize=0.7];
    e28 -> e51 [tooltip="peer: Query(Txn(1))", arrowsize=0.7];
    // message labels
    l0 [shape=plaintext, style=filled, fillcolor=white, fontsize=9, fontcolor="black", margin="0.03,0", height=0.14, label="prepare: Txn(1)", pos="83.3,-60.0!"];
    l1 [shape=plaintext, style=filled, fillcolor=white, fontsize=9, fontcolor="gray50", margin="0.03,0", height=0.14, label="prepare: Txn(1)", pos="250.0,-60.0!"];
    l3 [shape=plaintext, style=filled, fillcolor=white, fontsize=9, fontcolor="black", margin="0.03,0", height=0.14, label="vote: Txn(1)", pos="83.3,-104.0!"];
    l4 [shape=plaintext, style=filled, fillcolor=white, fontsize=9, fontcolor="black", margin="0.03,0", height=0.14, label="peer: Query(Txn(1))", pos="236.0,-152.0!"];
    l5 [shape=plaintext, style=filled, fillcolor=white, fontsize=9, fontcolor="black", margin="0.03,0", height=0.14, label="peer: Query(Txn(1))", pos="250.0,-164.0!"];
}
