digraph provenance {
    rankdir=TB;
    compound=true;
    node [fontname="Helvetica", fontsize=10];
    edge [fontname="Helvetica", fontsize=8];
    label="reliable delivery: why the goal held (record-level lineage)"; labelloc=t; fontname="Helvetica";
    subgraph cluster_0 {
        label="Process(loc2v1)"; style="rounded"; color="#999999";
        n1 [label="Process(loc2v1) output@2\n02000000\n(exec #20)", shape=box, style="rounded,filled", fillcolor="#e8f0fe"];
    }
    n0 [label="goal: some output on port 2", shape=doubleoctagon, style="filled,bold", fillcolor="#fff2b2"];
    n2 [label="msg:Msg { attempt: 2 }", shape=note, style=filled, fillcolor="#dff5dd"];
    n3 [label="local input\n(constant, timer, or external input)", shape=plaintext];
    n0 -> n1 [penwidth=2];
    n1 -> n2 [color="#1a56db", label="record", fontcolor="#888888"];
    n2 -> n3 [color="#1a56db", label="record", fontcolor="#888888"];
}
