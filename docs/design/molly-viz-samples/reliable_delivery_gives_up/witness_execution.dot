digraph lamport {
    layout=neato;
    splines=false;
    overlap=true;
    outputorder=edgesfirst;
    pad="0.3,0.2";
    node [fontname="Helvetica", fontsize=10];
    edge [fontname="Helvetica", fontsize=9];
    labelloc=t;
    fontname="Helvetica";
    label=<<FONT POINT-SIZE="12">goal held under {omit(msg:Msg { attempt: 1 })}: its support (★)</FONT><BR/><FONT POINT-SIZE="8" COLOR="gray40">— delivered    ⋯ in flight    ╌ ✗ omitted (red) / lost to a crash (gray)    ★ support</FONT>>;
    // the end of finite failures
    eff_l [shape=point, style=invis, width=0.01, pos="-27.0,-128.0!"];
    eff_r [shape=point, style=invis, width=0.01, pos="234.5,-128.0!"];
    t_eff [label="EFF", shape=plaintext, fontcolor="gray45", fontsize=9, margin="0.04,0", height=0.12, pos="246.5,-128.0!"];
    eff_l -> eff_r [style=dashed, color="gray45", arrowhead=none];
    // lanes
    h0 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bbbbbb", height=0.3, label="Process(loc1v1)", pos="0.0,0.0!"];
    h1 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bbbbbb", height=0.3, label="Process(loc2v1)", pos="198.5,0.0!"];
    e4 [shape=point, width=0.08, color="black", pos="0.0,-16.0!"];
    lost0 [shape=plaintext, label="✗", fontcolor="#c0392b", fontsize=13, width=0.2, height=0.2, fixedsize=true, margin=0, pos="198.5,-32.0!"];
    e8 [shape=point, width=0.08, color="#d35400", pos="0.0,-48.0!"];
    e12 [shape=point, width=0.08, color="#d35400", pos="198.5,-64.0!"];
    e14 [shape=point, width=0.08, color="black", pos="198.5,-80.0!"];
    e15 [shape=point, width=0.06, color="gray40", pos="198.5,-96.0!"];
    e19 [shape=point, width=0.08, color="black", pos="0.0,-112.0!"];
    end0 [shape=point, width=0.04, color="gray55", pos="0.0,-144.0!"];
    end1 [shape=point, width=0.04, color="gray55", pos="198.5,-144.0!"];
    h0 -> e4 [arrowhead=none, color="gray55"];
    e4 -> e8 [arrowhead=none, color="gray55"];
    e8 -> e19 [arrowhead=none, color="gray55"];
    e19 -> end0 [arrowhead=none, color="gray55"];
    h1 -> lost0 [arrowhead=none, color="gray55"];
    lost0 -> e12 [arrowhead=none, color="gray55"];
    e12 -> e14 [arrowhead=none, color="gray55"];
    e14 -> e15 [arrowhead=none, color="gray55"];
    e15 -> end1 [arrowhead=none, color="gray55"];
    // outputs
    o15 [shape=note, fontsize=9, style=filled, fillcolor="#fff7d6", color="gray40", margin="0.05,0.02", height=0.2, label="⇒ 02000000", pos="237.0,-96.0!"];
    // messages
    e4 -> lost0 [tooltip="msg: Msg { attempt: 1 } (omitted)", style=dashed, color="#c0392b", arrowhead=none];
    e8 -> e12 [tooltip="★ msg: Msg { attempt: 2 }", arrowsize=0.7, penwidth=2, color="#d35400"];
    e14 -> e19 [tooltip="ack: Ack { attempt: 2 }", arrowsize=0.7];
    // message labels
    l0 [shape=plaintext, style=filled, fillcolor=white, fontsize=9, fontcolor="#c0392b", margin="0.03,0", height=0.14, label="msg: Msg { attempt: 1 }", pos="99.2,-24.0!"];
    l1 [shape=plaintext, style=filled, fillcolor=white, fontsize=9, fontcolor="#d35400", margin="0.03,0", height=0.14, label="★ msg: Msg { attempt: 2 }", pos="99.2,-56.0!"];
    l2 [shape=plaintext, style=filled, fillcolor=white, fontsize=9, fontcolor="black", margin="0.03,0", height=0.14, label="ack: Ack { attempt: 2 }", pos="99.2,-96.0!"];
}
