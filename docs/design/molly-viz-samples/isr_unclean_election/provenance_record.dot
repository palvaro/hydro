digraph provenance {
    rankdir=TB;
    compound=true;
    node [fontname="Helvetica", fontsize=10];
    edge [fontname="Helvetica", fontsize=8];
    label="ISR replication: why the goal held (record-level lineage)"; labelloc=t; fontname="Helvetica";
    subgraph cluster_0 {
        label="observer"; style="rounded"; color="#999999";
        n1 [label="observer output@7\n0100000000000000…\n(exec #620)", shape=box, style="rounded,filled", fillcolor="#e8f0fe"];
    }
    n0 [label="goal: POST", shape=doubleoctagon, style="filled,bold", fillcolor="#fff2b2"];
    n2 [label="observed:View { leader: Some(0), isr: [0, 1] } from (Process(loc2v1), None) through send #0\n(observation)", shape=note, style="filled,dashed", fillcolor="#f0e6ff"];
    n3 [label="hb[0→]:()←replica@0#7", shape=note, style=filled, fillcolor="#dff5dd"];
    n4 [label="local input\n(constant, timer, or external input)", shape=plaintext];
    n5 [label="hb[1→]:()←replica@1#4", shape=note, style=filled, fillcolor="#dff5dd"];
    n6 [label="hb[0→]:()←replica@0#6", shape=note, style=filled, fillcolor="#dff5dd"];
    n7 [label="hb[1→]:()←replica@1#3", shape=note, style=filled, fillcolor="#dff5dd"];
    n8 [label="hb[1→]:()←replica@1#2", shape=note, style=filled, fillcolor="#dff5dd"];
    n9 [label="hb[0→]:()←replica@0#5", shape=note, style=filled, fillcolor="#dff5dd"];
    n10 [label="hb[0→]:()←replica@0#3", shape=note, style=filled, fillcolor="#dff5dd"];
    n11 [label="shrink[0→]:[2]←replica@0#2", shape=note, style=filled, fillcolor="#dff5dd"];
    n12 [label="write[→0]:Write(1)", shape=note, style="filled,dashed", fillcolor="#eeeeee", fontcolor="#666666"];
    n13 [label="hb[1→]:()←replica@1#1", shape=note, style=filled, fillcolor="#dff5dd"];
    n14 [label="observed:View { leader: Some(0), isr: [0, 1] } from (Process(loc2v1), None) through send #0\n(observation)", shape=note, style="filled,dashed", fillcolor="#f0e6ff"];
    n15 [label="observed:View { leader: Some(0), isr: [0, 1] } from (Process(loc2v1), None) through send #0\n(observation)", shape=note, style="filled,dashed", fillcolor="#f0e6ff"];
    n16 [label="observed:View { leader: Some(0), isr: [0, 1] } from (Process(loc2v1), None) through send #0\n(observation)", shape=note, style="filled,dashed", fillcolor="#f0e6ff"];
    n17 [label="observed[0→]:Write(1) from replica@0 through send #2←replica@0#2\n(observation)", shape=note, style="filled,dashed", fillcolor="#f0e6ff"];
    n0 -> n1 [penwidth=2];
    n1 -> n2 [color="#1a56db", label="record", fontcolor="#888888"];
    n1 -> n14 [color="#1a56db", label="record", fontcolor="#888888"];
    n1 -> n15 [color="#1a56db", label="record", fontcolor="#888888"];
    n1 -> n16 [color="#1a56db", label="record", fontcolor="#888888"];
    n1 -> n16 [color="#0b7a3b", penwidth=2, label="replay", fontcolor="#888888"];
    n1 -> n17 [color="#1a56db", label="record", fontcolor="#888888"];
    n1 -> n17 [color="#0b7a3b", penwidth=2, label="replay", fontcolor="#888888"];
    n2 -> n3 [color="#1a56db", label="record", fontcolor="#888888"];
    n2 -> n5 [color="#1a56db", label="record", fontcolor="#888888"];
    n2 -> n6 [color="#1a56db", label="record", fontcolor="#888888"];
