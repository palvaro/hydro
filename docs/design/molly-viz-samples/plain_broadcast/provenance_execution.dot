digraph provenance {
    rankdir=TB;
    compound=true;
    node [fontname="Helvetica", fontsize=10];
    edge [fontname="Helvetica", fontsize=8];
    label="plain broadcast: why the goal held (execution-level lineage)"; labelloc=t; fontname="Helvetica";
    subgraph cluster_0 {
        label="observer"; style="rounded"; color="#999999";
        n1 [label="observer output@5\n0103000000000000…\n(exec #93)", shape=box, style="rounded,filled", fillcolor="#e8f0fe"];
    }
    n0 [label="goal: POST", shape=doubleoctagon, style="filled,bold", fillcolor="#fff2b2"];
    n2 [label="observed[0→]:Payload(42) from member@0 through send #0←member@0#0\n(observation)", shape=note, style="filled,dashed", fillcolor="#f0e6ff"];
    n3 [label="observed[2→]:Payload(42) from member@2 through send #0←member@2#0\n(observation)", shape=note, style="filled,dashed", fillcolor="#f0e6ff"];
    n4 [label="observed[1→]:Payload(42) from member@1 through send #0←member@1#0\n(observation)", shape=note, style="filled,dashed", fillcolor="#f0e6ff"];
    n5 [label="initial[→2]:Payload(42)←broadcaster#2", shape=note, style=filled, fillcolor="#dff5dd"];
    n6 [label="initial[→1]:Payload(42)←broadcaster#1", shape=note, style=filled, fillcolor="#dff5dd"];
    n7 [label="initial[→0]:Payload(42)←broadcaster#0", shape=note, style=filled, fillcolor="#dff5dd"];
    n8 [label="local input\n(constant, timer, or external input)", shape=plaintext];
    n0 -> n1 [penwidth=2];
    n1 -> n2 [label="exec", fontcolor="#888888"];
    n1 -> n2 [color="#0b7a3b", penwidth=2, label="replay", fontcolor="#888888"];
    n1 -> n3 [label="exec", fontcolor="#888888"];
    n1 -> n3 [color="#0b7a3b", penwidth=2, label="replay", fontcolor="#888888"];
    n1 -> n4 [label="exec", fontcolor="#888888"];
    n1 -> n4 [color="#0b7a3b", penwidth=2, label="replay", fontcolor="#888888"];
    n2 -> n7 [label="exec", fontcolor="#888888"];
    n2 -> n7 [color="#1a56db", label="record", fontcolor="#888888"];
    n3 -> n5 [label="exec", fontcolor="#888888"];
    n3 -> n5 [color="#1a56db", label="record", fontcolor="#888888"];
    n4 -> n6 [label="exec", fontcolor="#888888"];
    n4 -> n6 [color="#1a56db", label="record", fontcolor="#888888"];
    n5 -> n8 [color="#1a56db", label="record", fontcolor="#888888"];
    n6 -> n8 [color="#1a56db", label="record", fontcolor="#888888"];
    n7 -> n8 [color="#1a56db", label="record", fontcolor="#888888"];
}
