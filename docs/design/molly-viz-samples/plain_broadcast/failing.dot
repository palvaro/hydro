digraph lamport {
    layout=neato;
    splines=false;
    overlap=true;
    outputorder=edgesfirst;
    pad="0.3,0.2";
    node [fontname="Helvetica", fontsize=10];
    edge [fontname="Helvetica", fontsize=9];
    labelloc=t;
    fontname="Helvetica";
    label=<<FONT POINT-SIZE="12">goal violated by {crash(broadcaster after initial[→1]:Payload(42))}</FONT><BR/><FONT POINT-SIZE="8" COLOR="gray40">— delivered    ⋯ in flight    ╌ ✗ omitted (red) / lost to a crash (gray)    ★ support</FONT>>;
    // lanes
    h0 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bbbbbb", height=0.3, label="broadcaster", pos="0.0,0.0!"];
    h1 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bbbbbb", height=0.3, label="member@0", pos="172.0,0.0!"];
    h2 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bbbbbb", height=0.3, label="member@1", pos="344.0,0.0!"];
    h3 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bbbbbb", height=0.3, label="member@2", pos="516.0,0.0!"];
    e1 [shape=point, width=0.08, color="black", pos="0.0,-16.0!"];
    e2 [shape=point, width=0.08, color="black", pos="0.0,-32.0!"];
    crash0 [shape=plaintext, style=filled, fillcolor=white, label="☠ crashed", fontsize=11, margin="0.04,0", height=0.16, pos="0.0,-48.0!"];
    e3 [shape=point, width=0.08, color="gray50", pos="0.0,-64.0!"];
    lost2 [shape=plaintext, label="✗", fontcolor="gray50", fontsize=13, width=0.2, height=0.2, fixedsize=true, margin=0, pos="516.0,-80.0!"];
    e15 [shape=point, width=0.08, color="black", pos="172.0,-96.0!"];
    e26 [shape=point, width=0.08, color="black", pos="344.0,-112.0!"];
    end0 [shape=point, width=0.04, color="gray55", pos="0.0,-128.0!"];
    end1 [shape=point, width=0.04, color="gray55", pos="172.0,-128.0!"];
    end2 [shape=point, width=0.04, color="gray55", pos="344.0,-128.0!"];
    end3 [shape=point, width=0.04, color="gray55", pos="516.0,-128.0!"];
    h0 -> e1 [arrowhead=none, color="gray55"];
    e1 -> e2 [arrowhead=none, color="gray55"];
    e2 -> crash0 [arrowhead=none, color="gray55"];
    crash0 -> e3 [arrowhead=none, style=dotted, color="gray80"];
    e3 -> end0 [arrowhead=none, style=dotted, color="gray80"];
    h1 -> e15 [arrowhead=none, color="gray55"];
    e15 -> end1 [arrowhead=none, color="gray55"];
    h2 -> e26 [arrowhead=none, color="gray55"];
    e26 -> end2 [arrowhead=none, color="gray55"];
    h3 -> lost2 [arrowhead=none, color="gray55"];
    lost2 -> end3 [arrowhead=none, color="gray55"];
    // messages
    e1 -> e15 [tooltip="initial: Payload(42)", arrowsize=0.7];
    e2 -> e26 [tooltip="initial: Payload(42)", arrowsize=0.7];
    e3 -> lost2 [tooltip="initial: Payload(42) (sender crashed)", style=dashed, color="gray50", arrowhead=none];
    // message labels
    l0 [shape=plaintext, style=filled, fillcolor=white, fontsize=9, fontcolor="black", margin="0.03,0", height=0.14, label="initial: Payload(42)", pos="103.2,-76.0!"];
    l1 [shape=plaintext, style=filled, fillcolor=white, fontsize=9, fontcolor="black", margin="0.03,0", height=0.14, label="initial: Payload(42)", pos="258.0,-92.0!"];
    l2 [shape=plaintext, style=filled, fillcolor=white, fontsize=9, fontcolor="gray50", margin="0.03,0", height=0.14, label="initial: Payload(42)", pos="258.0,-72.0!"];
}
