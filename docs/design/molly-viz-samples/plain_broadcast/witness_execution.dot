digraph lamport {
    layout=neato;
    splines=false;
    overlap=true;
    outputorder=edgesfirst;
    pad="0.3,0.2";
    node [fontname="Helvetica", fontsize=10];
    edge [fontname="Helvetica", fontsize=9];
    labelloc=t;
    fontname="Helvetica";
    label=<<FONT POINT-SIZE="12">goal held under {}: its support (★)</FONT><BR/><FONT POINT-SIZE="8" COLOR="gray40">— delivered    ⋯ in flight    ╌ ✗ omitted (red) / lost to a crash (gray)    ★ support</FONT>>;
    // lanes
    h0 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bbbbbb", height=0.3, label="broadcaster", pos="0.0,0.0!"];
    h1 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bbbbbb", height=0.3, label="member@0", pos="182.6,0.0!"];
    h2 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bbbbbb", height=0.3, label="member@1", pos="365.2,0.0!"];
    h3 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bbbbbb", height=0.3, label="member@2", pos="547.8,0.0!"];
    e1 [shape=point, width=0.08, color="#d35400", pos="0.0,-16.0!"];
    e2 [shape=point, width=0.08, color="#d35400", pos="0.0,-32.0!"];
    e3 [shape=point, width=0.08, color="#d35400", pos="0.0,-48.0!"];
    e16 [shape=point, width=0.08, color="#d35400", pos="547.8,-64.0!"];
    e27 [shape=point, width=0.08, color="#d35400", pos="365.2,-80.0!"];
    e38 [shape=point, width=0.08, color="#d35400", pos="182.6,-96.0!"];
    end0 [shape=point, width=0.04, color="gray55", pos="0.0,-112.0!"];
    end1 [shape=point, width=0.04, color="gray55", pos="182.6,-112.0!"];
    end2 [shape=point, width=0.04, color="gray55", pos="365.2,-112.0!"];
    end3 [shape=point, width=0.04, color="gray55", pos="547.8,-112.0!"];
    h0 -> e1 [arrowhead=none, color="gray55"];
    e1 -> e2 [arrowhead=none, color="gray55"];
    e2 -> e3 [arrowhead=none, color="gray55"];
    e3 -> end0 [arrowhead=none, color="gray55"];
    h1 -> e38 [arrowhead=none, color="gray55"];
    e38 -> end1 [arrowhead=none, color="gray55"];
    h2 -> e27 [arrowhead=none, color="gray55"];
    e27 -> end2 [arrowhead=none, color="gray55"];
    h3 -> e16 [arrowhead=none, color="gray55"];
    e16 -> end3 [arrowhead=none, color="gray55"];
    // messages
    e1 -> e38 [tooltip="★ initial: Payload(42)", arrowsize=0.7, penwidth=2, color="#d35400"];
    e2 -> e27 [tooltip="★ initial: Payload(42)", arrowsize=0.7, penwidth=2, color="#d35400"];
    e3 -> e16 [tooltip="★ initial: Payload(42)", arrowsize=0.7, penwidth=2, color="#d35400"];
    // message labels
    l0 [shape=plaintext, style=filled, fillcolor=white, fontsize=9, fontcolor="#d35400", margin="0.03,0", height=0.14, label="★ initial: Payload(42)", pos="109.6,-64.0!"];
    l1 [shape=plaintext, style=filled, fillcolor=white, fontsize=9, fontcolor="#d35400", margin="0.03,0", height=0.14, label="★ initial: Payload(42)", pos="273.9,-68.0!"];
    l2 [shape=plaintext, style=filled, fillcolor=white, fontsize=9, fontcolor="#d35400", margin="0.03,0", height=0.14, label="★ initial: Payload(42)", pos="292.2,-56.5!"];
}
