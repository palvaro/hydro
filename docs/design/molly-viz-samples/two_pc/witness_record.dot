digraph lamport {
    layout=neato;
    splines=false;
    overlap=true;
    outputorder=edgesfirst;
    pad="0.3,0.2";
    node [fontname="Helvetica", fontsize=10];
    edge [fontname="Helvetica", fontsize=9];
    labelloc=t;
    fontname="Helvetica";
    label=<<FONT POINT-SIZE="12">goal held under {}: its support (★)</FONT><BR/><FONT POINT-SIZE="8" COLOR="gray40">— delivered    ⋯ in flight    ╌ ✗ omitted (red) / lost to a crash (gray)    ★ support</FONT>>;
    // lanes
    h0 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bbbbbb", height=0.3, label="coordinator", pos="0.0,0.0!"];
    h1 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bbbbbb", height=0.3, label="participant@0", pos="156.1,0.0!"];
    h2 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bbbbbb", height=0.3, label="participant@1", pos="312.2,0.0!"];
    e1 [shape=point, width=0.08, color="#d35400", pos="0.0,-16.0!"];
    e2 [shape=point, width=0.08, color="#d35400", pos="0.0,-32.0!"];
    e13 [shape=point, width=0.08, color="#d35400", pos="312.2,-48.0!"];
    e15 [shape=point, width=0.08, color="#d35400", pos="312.2,-64.0!"];
    e19 [shape=point, width=0.08, color="#d35400", pos="0.0,-80.0!"];
    e21 [shape=point, width=0.08, color="#d35400", pos="156.1,-96.0!"];
    e23 [shape=point, width=0.08, color="#d35400", pos="156.1,-112.0!"];
    e27 [shape=point, width=0.08, color="#d35400", pos="0.0,-128.0!"];
    e29 [shape=point, width=0.08, color="#d35400", pos="0.0,-144.0!"];
    e30 [shape=point, width=0.08, color="#d35400", pos="0.0,-160.0!"];
    e36 [shape=point, width=0.08, color="#d35400", pos="312.2,-176.0!"];
    e47 [shape=point, width=0.08, color="#d35400", pos="156.1,-192.0!"];
    end0 [shape=point, width=0.04, color="gray55", pos="0.0,-208.0!"];
    end1 [shape=point, width=0.04, color="gray55", pos="156.1,-208.0!"];
    end2 [shape=point, width=0.04, color="gray55", pos="312.2,-208.0!"];
    h0 -> e1 [arrowhead=none, color="gray55"];
    e1 -> e2 [arrowhead=none, color="gray55"];
    e2 -> e19 [arrowhead=none, color="gray55"];
    e19 -> e27 [arrowhead=none, color="gray55"];
    e27 -> e29 [arrowhead=none, color="gray55"];
    e29 -> e30 [arrowhead=none, color="gray55"];
    e30 -> end0 [arrowhead=none, color="gray55"];
    h1 -> e21 [arrowhead=none, color="gray55"];
    e21 -> e23 [arrowhead=none, color="gray55"];
    e23 -> e47 [arrowhead=none, color="gray55"];
    e47 -> end1 [arrowhead=none, color="gray55"];
    h2 -> e13 [arrowhead=none, color="gray55"];
    e13 -> e15 [arrowhead=none, color="gray55"];
    e15 -> e36 [arrowhead=none, color="gray55"];
    e36 -> end2 [arrowhead=none, color="gray55"];
    // messages
    e1 -> e21 [tooltip="★ prepare: Txn(1)", arrowsize=0.7, penwidth=2, color="#d35400"];
    e2 -> e13 [tooltip="★ prepare: Txn(1)", arrowsize=0.7, penwidth=2, color="#d35400"];
    e15 -> e19 [tooltip="★ vote: Txn(1)", arrowsize=0.7, penwidth=2, color="#d35400"];
    e23 -> e27 [tooltip="★ vote: Txn(1)", arrowsize=0.7, penwidth=2, color="#d35400"];
    e29 -> e47 [tooltip="★ commit: Txn(1)", arrowsize=0.7, penwidth=2, color="#d35400"];
    e30 -> e36 [tooltip="★ commit: Txn(1)", arrowsize=0.7, penwidth=2, color="#d35400"];
    // message labels
    l0 [shape=plaintext, style=filled, fillcolor=white, fontsize=9, fontcolor="#d35400", margin="0.03,0", height=0.14, label="★ prepare: Txn(1)", pos="78.0,-56.0!"];
    l1 [shape=plaintext, style=filled, fillcolor=white, fontsize=9, fontcolor="#d35400", margin="0.03,0", height=0.14, label="★ prepare: Txn(1)", pos="234.1,-44.0!"];
    l2 [shape=plaintext, style=filled, fillcolor=white, fontsize=9, fontcolor="#d35400", margin="0.03,0", height=0.14, label="★ vote: Txn(1)", pos="234.1,-68.0!"];
    l3 [shape=plaintext, style=filled, fillcolor=white, fontsize=9, fontcolor="#d35400", margin="0.03,0", height=0.14, label="★ vote: Txn(1)", pos="78.0,-120.0!"];
    l4 [shape=plaintext, style=filled, fillcolor=white, fontsize=9, fontcolor="#d35400", margin="0.03,0", height=0.14, label="★ commit: Txn(1)", pos="93.7,-172.8!"];
    l5 [shape=plaintext, style=filled, fillcolor=white, fontsize=9, fontcolor="#d35400", margin="0.03,0", height=0.14, label="★ commit: Txn(1)", pos="234.1,-172.0!"];
}
