digraph lamport {
    layout=neato;
    splines=false;
    overlap=true;
    outputorder=edgesfirst;
    pad="0.3,0.2";
    node [fontname="Helvetica", fontsize=10];
    edge [fontname="Helvetica", fontsize=9];
    labelloc=t;
    fontname="Helvetica";
    label=<<FONT POINT-SIZE="12">goal violated by {crash(coordinator after commit[→0]:Txn(1))}</FONT><BR/><FONT POINT-SIZE="8" COLOR="gray40">— delivered    ⋯ in flight    ╌ ✗ omitted (red) / lost to a crash (gray)    ★ support</FONT>>;
    // lanes
    h0 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bbbbbb", height=0.3, label="coordinator", pos="0.0,0.0!"];
    h1 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bbbbbb", height=0.3, label="participant@0", pos="145.5,0.0!"];
    h2 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bbbbbb", height=0.3, label="participant@1", pos="291.0,0.0!"];
    e1 [shape=point, width=0.08, color="black", pos="0.0,-16.0!"];
    e2 [shape=point, width=0.08, color="black", pos="0.0,-32.0!"];
    e13 [shape=point, width=0.08, color="black", pos="145.5,-48.0!"];
    e15 [shape=point, width=0.08, color="black", pos="145.5,-64.0!"];
    e19 [shape=point, width=0.08, color="black", pos="291.0,-80.0!"];
    e21 [shape=point, width=0.08, color="black", pos="291.0,-96.0!"];
    e25 [shape=point, width=0.08, color="black", pos="0.0,-112.0!"];
    e26 [shape=point, width=0.08, color="black", pos="0.0,-128.0!"];
    e28 [shape=point, width=0.08, color="black", pos="0.0,-144.0!"];
    crash0 [shape=plaintext, style=filled, fillcolor=white, label="☠ crashed", fontsize=11, margin="0.04,0", height=0.16, pos="0.0,-160.0!"];
    e29 [shape=point, width=0.08, color="gray50", pos="0.0,-176.0!"];
    lost5 [shape=plaintext, label="✗", fontcolor="gray50", fontsize=13, width=0.2, height=0.2, fixedsize=true, margin=0, pos="291.0,-192.0!"];
    e33 [shape=point, width=0.08, color="black", pos="145.5,-208.0!"];
    end0 [shape=point, width=0.04, color="gray55", pos="0.0,-224.0!"];
    end1 [shape=point, width=0.04, color="gray55", pos="145.5,-224.0!"];
    end2 [shape=point, width=0.04, color="gray55", pos="291.0,-224.0!"];
    h0 -> e1 [arrowhead=none, color="gray55"];
    e1 -> e2 [arrowhead=none, color="gray55"];
    e2 -> e25 [arrowhead=none, color="gray55"];
    e25 -> e26 [arrowhead=none, color="gray55"];
    e26 -> e28 [arrowhead=none, color="gray55"];
    e28 -> crash0 [arrowhead=none, color="gray55"];
    crash0 -> e29 [arrowhead=none, style=dotted, color="gray80"];
    e29 -> end0 [arrowhead=none, style=dotted, color="gray80"];
    h1 -> e13 [arrowhead=none, color="gray55"];
    e13 -> e15 [arrowhead=none, color="gray55"];
    e15 -> e33 [arrowhead=none, color="gray55"];
    e33 -> end1 [arrowhead=none, color="gray55"];
    h2 -> e19 [arrowhead=none, color="gray55"];
    e19 -> e21 [arrowhead=none, color="gray55"];
    e21 -> lost5 [arrowhead=none, color="gray55"];
    lost5 -> end2 [arrowhead=none, color="gray55"];
    // messages
    e1 -> e13 [tooltip="prepare: Txn(1)", arrowsize=0.7];
    e2 -> e19 [tooltip="prepare: Txn(1)", arrowsize=0.7];
    e15 -> e25 [tooltip="vote: Txn(1)", arrowsize=0.7];
    e21 -> e26 [tooltip="vote: Txn(1)", arrowsize=0.7];
    e28 -> e33 [tooltip="commit: Txn(1)", arrowsize=0.7];
    e29 -> lost5 [tooltip="commit: Txn(1) (sender crashed)", style=dashed, color="gray50", arrowhead=none];
    // message labels
    l0 [shape=plaintext, style=filled, fillcolor=white, fontsize=9, fontcolor="black", margin="0.03,0", height=0.14, label="prepare: Txn(1)", pos="58.2,-28.8!"];
    l1 [shape=plaintext, style=filled, fillcolor=white, fontsize=9, fontcolor="black", margin="0.03,0", height=0.14, label="prepare: Txn(1)", pos="218.2,-68.0!"];
    l2 [shape=plaintext, style=filled, fillcolor=white, fontsize=9, fontcolor="black", margin="0.03,0", height=0.14, label="vote: Txn(1)", pos="72.8,-88.0!"];
    l3 [shape=plaintext, style=filled, fillcolor=white, fontsize=9, fontcolor="black", margin="0.03,0", height=0.14, label="vote: Txn(1)", pos="218.2,-104.0!"];
    l4 [shape=plaintext, style=filled, fillcolor=white, fontsize=9, fontcolor="black", margin="0.03,0", height=0.14, label="commit: Txn(1)", pos="72.8,-188.0!"];
    l5 [shape=plaintext, style=filled, fillcolor=white, fontsize=9, fontcolor="gray50", margin="0.03,0", height=0.14, label="commit: Txn(1)", pos="218.2,-188.0!"];
}
