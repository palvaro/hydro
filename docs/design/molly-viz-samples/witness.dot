digraph lamport {
    rankdir=TB;
    nodesep=0.9;
    ranksep=0.18;
    splines=line;
    node [fontname="Helvetica", fontsize=10];
    edge [fontname="Helvetica", fontsize=9];
    labelloc=t;
    label="goal held under {}: its support (★)";
    // time spine
    t_head [shape=point, style=invis];
    t1 [shape=point, style=invis];
    t2 [shape=point, style=invis];
    t5 [shape=point, style=invis];
    t7 [shape=point, style=invis];
    t13 [shape=point, style=invis];
    t15 [shape=point, style=invis];
    t17 [shape=point, style=invis];
    t19 [shape=point, style=invis];
    t21 [shape=point, style=invis];
    t23 [shape=point, style=invis];
    t25 [shape=point, style=invis];
    t27 [shape=point, style=invis];
    t29 [shape=point, style=invis];
    t30 [shape=point, style=invis];
    t32 [shape=point, style=invis];
    t34 [shape=point, style=invis];
    t36 [shape=point, style=invis];
    t47 [shape=point, style=invis];
    t_end [shape=point, style=invis];
    t_head -> t1 -> t2 -> t5 -> t7 -> t13 -> t15 -> t17 -> t19 -> t21 -> t23 -> t25 -> t27 -> t29 -> t30 -> t32 -> t34 -> t36 -> t47 -> t_end [style=invis, weight=1000];
    // lanes
    { rank=same; t_head; h0; h1; h2; }
    h0 [shape=box, style="rounded,filled", fillcolor="#eeeeee", label="coordinator"];
    h1 [shape=box, style="rounded,filled", fillcolor="#eeeeee", label="participant@0"];
    h2 [shape=box, style="rounded,filled", fillcolor="#eeeeee", label="participant@1"];
    h0 -> h1 -> h2 [style=invis];
    e1 [shape=point, width=0.09, color="#d97706"];
    { rank=same; t1; e1; }
    e2 [shape=point, width=0.09, color="#d97706"];
    { rank=same; t2; e2; }
    e17 [shape=point, width=0.09, color="#d97706"];
    { rank=same; t17; e17; }
    e19 [shape=point, width=0.09, color="#d97706"];
    { rank=same; t19; e19; }
    e25 [shape=point, width=0.09, color="#d97706"];
    { rank=same; t25; e25; }
    e27 [shape=point, width=0.09, color="#d97706"];
    { rank=same; t27; e27; }
    e29 [shape=point, width=0.09, color="#d97706"];
    { rank=same; t29; e29; }
    e30 [shape=point, width=0.09, color="#d97706"];
    { rank=same; t30; e30; }
    end0 [shape=point, width=0.05, color="gray60"];
    { rank=same; t_end; end0; }
    h0 -> e1 -> e2 -> e17 -> e19 -> e25 -> e27 -> e29 -> e30 -> end0 [arrowhead=none, color="gray60", weight=100];
    e5 [shape=point, width=0.09, color="#d97706"];
    { rank=same; t5; e5; }
    e21 [shape=point, width=0.09, color="#d97706"];
    { rank=same; t21; e21; }
    e23 [shape=point, width=0.09, color="#d97706"];
    { rank=same; t23; e23; }
    e32 [shape=point, width=0.09, color="#d97706"];
    { rank=same; t32; e32; }
    e47 [shape=point, width=0.09, color="#d97706"];
    { rank=same; t47; e47; }
    end1 [shape=point, width=0.05, color="gray60"];
    { rank=same; t_end; end1; }
    h1 -> e5 -> e21 -> e23 -> e32 -> e47 -> end1 [arrowhead=none, color="gray60", weight=100];
    e7 [shape=point, width=0.09, color="#d97706"];
    { rank=same; t7; e7; }
    e13 [shape=point, width=0.09, color="#d97706"];
    { rank=same; t13; e13; }
    e15 [shape=point, width=0.09, color="#d97706"];
    { rank=same; t15; e15; }
    e34 [shape=point, width=0.09, color="#d97706"];
    { rank=same; t34; e34; }
    e36 [shape=point, width=0.09, color="#d97706"];
    { rank=same; t36; e36; }
    end2 [shape=point, width=0.05, color="gray60"];
    { rank=same; t_end; end2; }
    h2 -> e7 -> e13 -> e15 -> e34 -> e36 -> end2 [arrowhead=none, color="gray60", weight=100];
    // messages
    e1 -> e21 [label="★ prepare: Txn(1)", constraint=false, penwidth=2.2, color="#d97706", fontcolor="#d97706"];
    e2 -> e13 [label="★ prepare: Txn(1)", constraint=false, penwidth=2.2, color="#d97706", fontcolor="#d97706"];
    e15 -> e19 [label="★ vote: Txn(1)", constraint=false, penwidth=2.2, color="#d97706", fontcolor="#d97706"];
    e23 -> e27 [label="★ vote: Txn(1)", constraint=false, penwidth=2.2, color="#d97706", fontcolor="#d97706"];
    e29 -> e47 [label="★ commit: Txn(1)", constraint=false, penwidth=2.2, color="#d97706", fontcolor="#d97706"];
    e30 -> e36 [label="★ commit: Txn(1)", constraint=false, penwidth=2.2, color="#d97706", fontcolor="#d97706"];
}
