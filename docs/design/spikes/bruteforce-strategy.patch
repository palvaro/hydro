+                    verdict(&outcome),
+                    outcome.runs().len(),
+                    outcome.schedules(),
+                    took.as_secs_f64()
+                );
+                verdicts.push(outcome.is_counterexample());
+            }
+            assert!(
+                verdicts.iter().all(|v| *v == verdicts[0]),
+                "the strategies must agree on whether a violation exists: {verdicts:?}"
+            );
+        }
     }
 
