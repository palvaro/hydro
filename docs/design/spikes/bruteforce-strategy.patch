+
+    /// Every hypothesis [`enumerate_hypothesis`] proposes over `universe`, in order.
+    fn enumerate_all(
+        universe: &[Fault],
+        max_omissions: Option<usize>,
+        vacuous: &[FaultSet],
+        bounds: &CrashBounds,
+    ) -> Vec<FaultSet> {
+        let mut tried = BTreeSet::from([FaultSet::new()]);
+        let mut out = vec![];
+        while let Some(h) = enumerate_hypothesis(universe, max_omissions, &tried, vacuous, bounds) {
+            assert!(tried.insert(h.clone()), "a hypothesis is proposed once");
+            out.push(h);
+            assert!(out.len() < 10_000, "the enumeration terminates");
+        }
+        out
+    }
+
+    /// A universe of two lossy messages and two crashable senders with two crash points each
+    /// (before any send, and after the first send).
+    fn mixed_universe() -> (Vec<Clause>, Vec<Fault>) {
+        let (m0, m1) = (send(0, 1), send(1, 1));
+        let (n0, n1) = (send(0, 2), send(1, 2));
+        let sends = Rc::new(SendSequences::from([
+            ("s".to_owned(), vec![m0, m1]),
+            ("t".to_owned(), vec![n0, n1]),
+        ]));
+        let clauses = vec![clause(
+            [
+                lossy("a", 1),
+                lossy("a", 2),
+                reliable("r", 1, "s", 0),
+                reliable("r", 2, "s", 1),
+                reliable("r", 3, "t", 0),
+                reliable("r", 4, "t", 1),
+            ],
+            &sends,
+        )];
+        let universe = universe_of(&clauses);
+        (clauses, universe)
+    }
+
+    /// Without an omission cap the brute-force enumeration visits exactly the sets the blind
+    /// solver does (no clauses), by non-decreasing size.
+    #[test]
+    fn brute_force_matches_blind_solver_without_an_omission_cap() {
+        let (_, universe) = mixed_universe();
+        assert_eq!(universe.len(), 2 + 2 + 2, "{universe:?}");
+        for bounds in [
+            CrashBounds::budget(1),
+            CrashBounds {
+                budget: None,
+                nodes: 3,
+                checked: None,
+            },
+        ] {
+            let brute = enumerate_all(&universe, None, &[], &bounds);
+            let mut tried = BTreeSet::from([FaultSet::new()]);
+            let mut blind = vec![];
+            while let Some(h) = next_hypothesis(&universe, &[], &[], &tried, &[], &bounds) {
+                assert!(tried.insert(h.clone()));
+                blind.push(h);
+            }
+            assert!(
+                brute.windows(2).all(|w| w[0].len() <= w[1].len()),
+                "{brute:?}"
+            );
+            assert_eq!(
+                brute.iter().cloned().collect::<BTreeSet<_>>(),
+                blind.iter().cloned().collect::<BTreeSet<_>>()
+            );
+        }
+    }
+
+    /// The omission cap, the one-crash-per-node rule, the crash bounds and the vacuous sets
+    /// all prune.
+    #[test]
+    fn brute_force_honours_caps_and_vacuous_sets() {
+        let (_, universe) = mixed_universe();
+        let omits = |h: &FaultSet| h.iter().filter(|f| matches!(f, Fault::Omit(_))).count();
+        let crashes = |h: &FaultSet| h.len() - omits(h);
+        // ≤ 1 omission, ≤ 1 crash: 2 + 4 + 2·4 sets.
+        let all = enumerate_all(&universe, Some(1), &[], &CrashBounds::budget(1));
+        assert_eq!(all.len(), 2 + 4 + 8, "{all:?}");
+        assert!(all.iter().all(|h| omits(h) <= 1 && crashes(h) <= 1));
+        // Unbounded crashes, two nodes: never two crash points of the same node.
+        let all = enumerate_all(&universe, Some(0), &[], &CrashBounds::default());
+        assert_eq!(all.len(), 4 + 4, "{all:?}");
+        // The checked-cluster cap binds on its members only.
+        let checked = CrashBounds {
+            budget: None,
+            nodes: 0,
+            checked: Some(CheckedCluster {
+                nodes: BTreeSet::from(["s".to_owned(), "t".to_owned()]),
+                cap: 1,
+            }),
+        };
+        let all = enumerate_all(&universe, Some(0), &[], &checked);
+        assert_eq!(all.len(), 4, "{all:?}");
+        // No superset of a vacuous set.
+        let vacuous = vec![FaultSet::from([universe[0].clone()])];
+        let all = enumerate_all(&universe, Some(2), &vacuous, &CrashBounds::budget(0));
+        assert_eq!(all, vec![FaultSet::from([universe[1].clone()])]);
+    }
 }
