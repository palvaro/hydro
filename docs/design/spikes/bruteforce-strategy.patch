+/// The next hypothesis of [`Strategy::BruteForce`]: the first untried admissible subset of
+/// `universe` (sorted weakest first) by increasing size, and within a size in lexicographic
+/// order of positions in `universe`, so the weakest faults are combined first. Admissible means
+/// what it means for [`solve_hypothesis`] with no clauses: at most one crash per node, the
+/// crashes within `bounds`, no superset of a vacuous set; plus at most `max_omissions`
+/// omissions (`None`: unbounded). No solver and no lineage: a depth-first walk over the
+/// combinations with the constraints as pruning. `None` when every admissible set was tried.
+fn enumerate_hypothesis(
+    universe: &[Fault],
+    max_omissions: Option<usize>,
+    tried: &BTreeSet<FaultSet>,
+    vacuous: &[FaultSet],
+    bounds: &CrashBounds,
+) -> Option<FaultSet> {
+    struct Walk<'a> {
+        universe: &'a [Fault],
+        max_omissions: usize,
+        max_crashes: usize,
+        checked: Option<&'a CheckedCluster>,
+        tried: &'a BTreeSet<FaultSet>,
+        vacuous: &'a [FaultSet],
+        chosen: Vec<usize>,
+    }
+
+    impl Walk<'_> {
+        fn admits(&self, fault: &Fault) -> bool {
+            let picked = || self.chosen.iter().map(|&i| &self.universe[i]);
+            match fault {
+                Fault::Omit(_) => {
+                    picked().filter(|f| matches!(f, Fault::Omit(_))).count() < self.max_omissions
+                }
+                Fault::Crash { node, .. } => {
+                    let crashed: Vec<&String> = picked()
+                        .filter_map(|f| match f {
+                            Fault::Crash { node, .. } => Some(node),
+                            Fault::Omit(_) => None,
+                        })
+                        .collect();
+                    crashed.len() < self.max_crashes
+                        && !crashed.contains(&node)
+                        && self.checked.is_none_or(|checked| {
+                            !checked.nodes.contains(node)
+                                || crashed
+                                    .iter()
+                                    .filter(|n| checked.nodes.contains(**n))
+                                    .count()
+                                    < checked.cap
+                        })
+                }
+            }
+        }
+
+        /// The first untried admissible set that extends `chosen` with `remaining` more faults
+        /// drawn from `universe[start..]`.
+        fn pick(&mut self, start: usize, remaining: usize) -> Option<FaultSet> {
+            if remaining == 0 {
+                let set: FaultSet = self
+                    .chosen
+                    .iter()
+                    .map(|&i| self.universe[i].clone())
+                    .collect();
+                let fresh =
+                    !self.tried.contains(&set) && !self.vacuous.iter().any(|v| v.is_subset(&set));
+                return fresh.then_some(set);
+            }
+            for i in start..self.universe.len().saturating_sub(remaining - 1) {
+                if !self.admits(&self.universe[i]) {
+                    continue;
+                }
+                self.chosen.push(i);
+                let found = self.pick(i + 1, remaining - 1);
+                self.chosen.pop();
+                if found.is_some() {
+                    return found;
+                }
+            }
+            None
+        }
+    }
+
+    let omissions = universe
+        .iter()
+        .filter(|f| matches!(f, Fault::Omit(_)))
+        .count();
+    let crash_nodes = universe
+        .iter()
+        .filter_map(|f| match f {
+            Fault::Crash { node, .. } => Some(node),
+            Fault::Omit(_) => None,
+        })
+        .collect::<BTreeSet<_>>()
+        .len();
+    let max_omissions = max_omissions.map_or(omissions, |m| m.min(omissions));
+    let mut max_crashes = crash_nodes;
+    if let Some(budget) = bounds.budget {
+        max_crashes = max_crashes.min(budget);
+    }
+    if bounds.nodes >= 1 {
+        max_crashes = max_crashes.min(bounds.nodes - 1);
+    }
+    let mut walk = Walk {
+        universe,
+        max_omissions,
+        max_crashes,
+        checked: bounds.checked.as_ref(),
+        tried,
+        vacuous,
+        chosen: vec![],
+    };
+    (0..=max_omissions + max_crashes).find_map(|size| walk.pick(0, size))
+}
