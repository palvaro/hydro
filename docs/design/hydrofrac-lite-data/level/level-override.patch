+/// Scratch patch: `LDFI_LEVEL` overrides every explicit `.level(..)`.
+fn env_level_override() -> Option<Level> {
+    match std::env::var("LDFI_LEVEL").as_deref() {
+        Ok("exec" | "execution") => Some(Level::Execution),
+        Ok("precise" | "record") => Some(Level::Precise),
+        _ => None,
+    }
+}
