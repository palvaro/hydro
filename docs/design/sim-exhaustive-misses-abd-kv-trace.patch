diff --git a/hydro_lang/src/sim/trace_driver.rs b/hydro_lang/src/sim/trace_driver.rs
new file mode 100644
index 0000000000..48679322ab
--- /dev/null
+++ b/hydro_lang/src/sim/trace_driver.rs
@@ -0,0 +1,142 @@
+//! INVESTIGATION ONLY (not committed): a bolero driver that mirrors the exhaustive driver's
+//! `select(bound)` semantics, follows a script, then either all-zeros (exhaustive's first
+//! alternative) or uniform random, and records every non-trivial choice `(value, bound)`.
+
+use std::cell::RefCell;
+use std::ops::Bound;
+use std::rc::Rc;
+
+
+pub type Trace = Rc<RefCell<Vec<(u64, u64)>>>;
+
+pub struct TraceDriver {
+    pub script: Vec<u64>,
+    pub cursor: usize,
+    pub rng: Option<u64>,
+    pub trace: Trace,
+    pub print: bool,
+}
+
+impl TraceDriver {
+    fn select(&mut self, bound: u64) -> u64 {
+        if bound == 0 {
+            return 0;
+        }
+        let v = if self.cursor < self.script.len() {
+            self.script[self.cursor].min(bound)
+        } else if let Some(s) = &mut self.rng {
+            // xorshift64*
+            *s ^= *s >> 12;
+            *s ^= *s << 25;
+            *s ^= *s >> 27;
+            let r = s.wrapping_mul(0x2545F4914F6CDD1D);
+            if bound == u64::MAX { r } else { r % (bound + 1) }
+        } else {
+            0
+        };
+        if self.print {
+            eprintln!("    #choice {} = {} of 0..={}", self.cursor, v, bound);
+        }
+        self.cursor += 1;
+        self.trace.borrow_mut().push((v, bound));
+        v
+    }
+}
+
+macro_rules! gen_int {
+    ($fun:ident, $ty:ident) => {
+        fn $fun(&mut self, min: Bound<&$ty>, max: Bound<&$ty>) -> Option<$ty> {
+            let lo: i128 = match min {
+                Bound::Included(v) => *v as i128,
+                Bound::Excluded(v) => *v as i128 + 1,
+                Bound::Unbounded => $ty::MIN as i128,
+            };
+            let hi: i128 = match max {
+                Bound::Included(v) => *v as i128,
+                Bound::Excluded(v) => *v as i128 - 1,
+                Bound::Unbounded => $ty::MAX as i128,
+            };
+            if lo > hi {
+                return None;
+            }
+            let v = self.select((hi - lo) as u64);
+            Some((lo + v as i128) as $ty)
+        }
+    };
+}
+
+impl bolero::Driver for TraceDriver {
+    fn depth(&self) -> usize {
+        0
+    }
+    fn set_depth(&mut self, _depth: usize) {}
+    fn max_depth(&self) -> usize {
+        usize::MAX
+    }
+    fn gen_variant(&mut self, variants: usize, _base_case: usize) -> Option<usize> {
+        Some(self.select(variants as u64 - 1) as usize)
+    }
+    gen_int!(gen_u8, u8);
+    gen_int!(gen_i8, i8);
+    gen_int!(gen_u16, u16);
+    gen_int!(gen_i16, i16);
+    gen_int!(gen_u32, u32);
+    gen_int!(gen_i32, i32);
+    gen_int!(gen_u64, u64);
+    gen_int!(gen_i64, i64);
+    gen_int!(gen_usize, usize);
+    gen_int!(gen_isize, isize);
+    fn gen_u128(&mut self, _min: Bound<&u128>, _max: Bound<&u128>) -> Option<u128> {
+        None
+    }
+    fn gen_i128(&mut self, _min: Bound<&i128>, _max: Bound<&i128>) -> Option<i128> {
+        None
+    }
+    fn gen_f32(&mut self, _min: Bound<&f32>, _max: Bound<&f32>) -> Option<f32> {
+        None
+    }
+    fn gen_f64(&mut self, _min: Bound<&f64>, _max: Bound<&f64>) -> Option<f64> {
+        None
+    }
+    fn gen_char(&mut self, _min: Bound<&char>, _max: Bound<&char>) -> Option<char> {
+        None
+    }
+    fn gen_bool(&mut self, _probability: Option<f32>) -> Option<bool> {
+        Some(self.select(1) == 1)
+    }
+    fn gen_from_bytes<Hint, Gen, T>(&mut self, _hint: Hint, _produce: Gen) -> Option<T>
+    where
+        Hint: FnOnce() -> (usize, Option<usize>),
+        Gen: FnMut(&[u8]) -> Option<(usize, T)>,
+    {
+        None
+    }
+}
+
+impl super::compiled::CompiledSim {
+    /// Runs one instance (in exhaustive mode) under `driver`; returns whether the body panicked.
+    pub fn run_traced(
+        &self,
+        driver: TraceDriver,
+        mut thunk: impl AsyncFnMut() + std::panic::RefUnwindSafe,
+    ) -> bool {
+        self.with_instantiator(
+            |instantiator| {
+                let instance = instantiator();
+                let r = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+                    bolero::bolero_engine::any::scope::with(
+                        Box::new(bolero::bolero_engine::driver::object::Object(driver)),
+                        || {
+                            tokio::runtime::Builder::new_current_thread()
+                                .build()
+                                .unwrap()
+                                .block_on(instance.run_exhaustive_mode(&mut thunk));
+                        },
+                    );
+                }));
+                r.is_err()
+            },
+            false,
+        )
+    }
+}
